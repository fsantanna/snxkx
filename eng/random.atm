;; Random numbers, as `Random` of the original. The seed comes from
;; SNX_SEED, or else from the clock (the test mode seeds 1).

math.randomseed(tonumber(os.getenv("SNX_SEED") || "") ||
                (if eng.testing() => 1 => os.time()))

;; A real in [a,b], as `random:float(a, b)`.
func rfloat (a, b) {
    val lo = a || 0
    val hi = if b == nil => 1 => b
    lo + math.random()*(hi - lo)
}

;; An integer in [a,b], as `random:int(a, b)`.
func rint (a, b) {
    math.random(a, b)
}

;; An element of a vector, as `random:table(t)`.
func rtable (t) {
    t@(math.random(#t))
}

;; True with a chance in percent, as `random:bool(chance)`.
func rbool (chance) {
    math.random(1, 1000) < 10*(chance || 50)
}
