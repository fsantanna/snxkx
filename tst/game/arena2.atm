;; The arena with one unit turning left (key A held) among many seekers,
;; until it dies, and the arena returns.
include "../../src/game.atm"

spawn Background()
spawn Camera()
spawn Input()
spawn SlowMotion()

val A = new_arena(1)
val es = []
loop i in 12 {
    set es@+ = [100 + 25*i, 80 + 10*(i%5), 5]
}
set A.run = [ units=[["vagrant", 1]], gold=3 ]
val r = await Arena(A, es)
print(eng.tick(), r, #A.enemies)
