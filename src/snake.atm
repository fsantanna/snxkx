;; The snake: a leader and its followers, each one a unit, as `Player` of
;; the original (`player.lua`), without its attacks.
;;
;; A unit is a task with a record. The records of the snake are in
;; `A.units`, in order: the first is the leader. The leader turns with
;; the keys, keeps its last positions, and bounces on the walls; each
;; follower takes the position of the leader 10.4 pixels per place
;; behind it along that path.
;;
;; The hits between units and enemies are events, as the methods of the
;; original: `:Hit [to, dmg]` and `:Push [to, f, r]`, emitted to the
;; whole arena, for the task of the record `to`.

;; As `math.remap`.
func remap (v, a, b, c, d) {
    c + (v - a)*(d - c)/(b - a)
}

;; As `math.lerp_angle_dt(f, dt, src, dst)`.
func lerp_angle_dt (f, dt, src, dst) {
    lerp_angle(1 - math.pow(f, dt), src, dst)
}

;; Emits a hit, a push, or a slow motion to the whole program.
func hit (to, dmg, o) {
    emit @:global :Hit ([ to=to, dmg=dmg ] ++ (o || []))
}
func push (to, f, r, inv) {
    emit @:global :Push [ to=to, f=f, r=r, inv=inv ]
}
func slow (amount, duration) {
    emit @:global :Slow [ amount=amount || 0.5, duration=duration || 0.5 ]
}

;; As `Seeker:slow(amount, duration)`: the enemy moves at `amount` of its
;; speed for a while (a new slow restarts it).
func slow_enemy (to, amount, duration) {
    emit @:global :Slowed [ to=to, amount=amount, duration=duration ]
}

;; As `Seeker:apply_dot(dmg, duration, color)`: `dmg` over time, a
;; quarter every 0.25s.
func dot (to, dmg, duration, color) {
    emit @:global :Dot [ to=to, dmg=dmg, duration=duration, color=color ]
}

;; As `Seeker:curse(kind, duration, a1, a2, a3)`.
func curse (to, kind, duration, a1, a2, a3) {
    emit @:global :Curse [ to=to, kind=kind, duration=duration, a1=a1, a2=a2, a3=a3 ]
}

;; A stun, as the barbarian and the stunning strike: slowed to 0.1, no
;; attacks, and twice the damage, for `d` seconds.
func stun (to, d) {
    slow_enemy(to, 0.1, d)
    emit @:global :Stun [ to=to, d=d ]
}

;; The slow motion of the original (`slow(amount, duration)` in
;; `shared.lua`): the game time drops to `amount` and comes back to
;; normal along `duration`, in real time. A new slow restarts it.
task SlowMotion () {
    var e = await :Slow
    loop {
        set e = par :any {
            await :Slow
        } with {
            val st = [ v=e.amount ]
            eng.slow(st.v)
            spawn {
                loop on :tick {
                    eng.slow(st.v)
                }
            }
            await TweenReal(e.duration, st, [v=1], cubic_in_out)
            eng.slow(1)
            await :Slow
        }
    }
}

;; Shows the bar of hp for `n` seconds, as `Unit:show_hp`: every call
;; restarts it (the bar shows while any is on).
task ShowHp (u, n) {
    set u.hp_shown += 1
    defer {
        set u.hp_shown -= 1
    }
    await((n || 2) * 1s)
}

;; The bar of hp of a unit, as `HPBar:draw`.
func draw_hp_bar (u, w, h, color) {
    if u.hp_shown > 0 {
        eng.push(u.x, u.y, 0, u.hit.s.x)
        eng.line(u.x - 0.5*w, u.y - h, u.x + 0.5*w, u.y - h, bg@(-3), 2)
        val n = remap(u.hp, 0, u.max_hp, 0, 1)
        eng.line(u.x - 0.5*w, u.y - h, u.x - 0.5*w + n*w, u.y - h,
                 if u.hit.f > 0 => fg@0 => color, 2)
        eng.pop()
    }
}

;; Bounces on a wall with an axis-aligned normal, as `Unit:bounce`.
func bounce (u, nx, ny) {
    val vx, vy = body_vel(u.b)
    if nx == 0 {
        body_set(u.b, :velocity, vx, -vy)
        set u.r = 2*math.pi - u.r
    }
    if ny == 0 {
        body_set(u.b, :velocity, -vx, vy)
        set u.r = math.pi - u.r
    }
}

;; The angle from a unit to a point.
func angle_to (u, x, y) {
    math.atan2(y - u.y, x - u.x)
}

;; A unit of the snake. `u` has `character` and `level`, and `x`, `y`,
;; `r` for the leader. `fx` and `shots` are the pools of the effects and
;; of the projectiles of the arena.
task Unit (A, u, fx, shots) {
    set u.kind    = :player
    set u.classes = character_classes@(u.character)
    set u.color   = character_colors@(u.character)
    set u.hit     = hfx(1)
    set u.shoot   = hfx(1)
    set u.hp_shown = 0
    set u.w = 9
    set u.h = 9
    set u.x = u.x || 0
    set u.y = u.y || 0
    set u.r = u.r || 0
    unit_stats(u, true, A.ng)
    body(A.w, u, :dynamic, u.x, u.y, :player, [:rect, 9, 9])
    body_set(u.b, :angle, u.r)
    defer {
        body_free(A.w, u.b)
    }
    spawn Springs(u.hit.s, u.shoot.s)
    ;; the effects of the unit (a flash, its bar of hp): they live with the
    ;; unit, not with the reaction that starts them
    pin fxs = tasks()
    spawn {
        if !A.menu {
            await Character(A, u, fx, shots)
        }
    }

    ;; the chain infusion of the stormweaver (`chain_infuse`, a tagged timer)
    spawn {
        loop i on :Infuse until it.to == u {
            spawn @fxs Cursed(u, "chain_infused", true, i.d)
        }
    }

    ;; heals, as `Player:heal`
    spawn {
        loop e on :Heal until it.to == u {
            spawn @fxs HfxUse(u.hit, 0.25, 200, 10)
            spawn @fxs ShowHp(u, 1.5)
            set u.hp = math.min(u.hp + e.amount, u.max_hp)
            if u.chp {
                spawn @fxs HfxUse(u.chp, 0.5)
            }
        }
    }

    ;; the stats with the buffs of the others, in every tick
    spawn {
        loop on :clock {
            unit_buffs(A, u)
            unit_stats(u, false, A.ng)
        }
    }

    spawn {
        loop on :draw {
            eng.push(u.x, u.y, u.r, u.hit.s.x*u.shoot.s.x)
            eng.rect(u.x, u.y, 9, 9, 3, 3,
                     if (u.hit.f > 0) || (u.shoot.f > 0) => fg@0 => u.color)
            eng.pop()
            draw_hp_bar(u, 9, 9, green@0)
        }
    }

    ;; the enemies: both push and hit
    spawn {
        loop e on :collision.enter until (it.b == u.b) && (it.other.kind == :enemy) {
            val o = e.other
            push(o, rfloat(25, 35)*(u.knockback_m || 1), angle_to(u, o.x, o.y))
            hit(o, if (u.character == "vagrant") || (u.character == "psykeeper") => 2*u.dmg => u.dmg)
            if o.headbutting {
                hit(u, (4 + math.floor(o.level/3))*o.dmg)
                set o.headbutting = false
            } else {
                hit(u, o.dmg)
            }
            spawn @fx HitCircle(e.x, e.y, [rs=6, color=fg@0, duration=0.1])
            loop _ in 2 {
                spawn @fx HitParticle(e.x, e.y, [color=u.color])
            }
            loop _ in 2 {
                spawn @fx HitParticle(e.x, e.y, [color=o.color])
            }
        }
    }

    par :any {
        ;; the life of the unit: until its hp ends
        loop e on :Hit until it.to == u {
            spawn @fxs HfxUse(u.hit, 0.25, 200, 10)
            spawn @fxs ShowHp(u)
            if u.chp {
                spawn @fxs HfxUse(u.chp, 0.5)
            }
            val dmg = if STRESS => 0 => math.max(unit_damage(u, e.dmg), 0)
            if (u.character == "beastmaster") && (u.level == 3) {
                play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                loop _ in 4 {
                    spawn @shots Critter(A, u.x, u.y, rfloat(0, 2*math.pi), 20, u.dmg, u, fx)
                }
            }
            set u.hp -= dmg
            play(rtable([player_hit1, player_hit2]), [pitch=rfloat(0.95, 1.05), volume=0.5])
            shake(4, 0.5)
            set A.damage_taken += dmg
            trace("unit.hit", u.character ++ " " ++ string.format("%.1f", u.hp))
            if u.character == "psykeeper" {
                ;; it stores the damage, and turns it into healing orbs
                set u.stored_heal = (u.stored_heal || 0) + dmg
                if u.stored_heal > (0.25*u.max_hp) {
                    set u.stored_heal = 0
                    val x, y = free_place(A)
                    loop _ in 3 {
                        spawn @fx HealAt(A, x, y, fx)
                    }
                }
                if u.level == 3 {
                    val es = A.enemies
                    loop _, o in es {
                        hit(o, 2*dmg/#es)
                    }
                }
            }
            if (u.hp <= 0) && u.divined {
                ;; the priest of level 3 saves it once
                set u.hp = u.max_hp
                play(heal1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                play(buff1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                loop _ in rint(4, 6) {
                    spawn @fx HitParticle(u.x, u.y, [color=u.color])
                }
                spawn @fx HitCircle(u.x, u.y, [rs=12, scale_down=true, duration=0.3, change_color=[0.5, u.color]])
                set u.divined = false
            }
            until u.hp <= 0
        }
    } with {
        ;; a follower, until the units ahead of it die
        if A.units@0 != u {
            par :any {
                ;; first, until there is a place for it on the path
                loop on :clock {
                    set u.x, u.y = body_pos(u.b)
                    set u.r = body_angle(u.b)
                    until snake_place(A, u)
                }
                play(spawn1, [pitch=rfloat(0.8, 1.2), volume=0.15])
                loop _ in rint(3, 4) {
                    spawn @fx HitParticle(u.x, u.y, [color=u.color])
                }
                spawn @fx HitCircle(u.x, u.y, [rs=10, color=fg@0, scale_down=true,
                                               duration=0.3, change_color=[0.5, u.color]])
                ;; then along the path of the leader
                loop on :clock {
                    set u.x, u.y = body_pos(u.b)
                    val p = snake_place(A, u)
                    if p {
                        body_set(u.b, :position, p.x, p.y)
                        set u.r = p.r
                    } else {
                        set u.r = body_angle(u.b)
                    }
                }
            } with {
                await :Snake.lead until it.u == u
            }
        }
        ;; the leader
        par {
            loop us on :clock {
                val dt = us / 1000000
                ;; the path, as `previous_positions` (every 0.01s: every tick)
                set A.path = [ [x=u.x, y=u.y, r=u.r] ] ++ A.path
                if #A.path > 256 {
                    set A.path@(256) = nil
                }
                set u.x, u.y = body_pos(u.b)
                if !A.menu {
                    if HELD.left > 0 {
                        set u.r -= 1.66*math.pi*dt
                    }
                    if HELD.right > 0 {
                        set u.r += 1.66*math.pi*dt
                    }
                }
                var total = 0
                loop _, o in A.units {
                    set total += o.max_v
                }
                set total = math.floor(total / #A.units)
                body_set(u.b, :velocity, total*math.cos(u.r), total*math.sin(u.r))
                if !A.menu {
                    val vx, vy = body_vel(u.b)
                    val hd = remap(math.abs(u.x - W/2), 0, 192, 1, 0)
                    val vd = remap(math.abs(u.y - H/2), 0, 108, 1, 0)
                    set CAM.x += remap(vx, -100, 100, -24*hd, 24*hd)*dt
                    set CAM.y += remap(vy, -100, 100, -8*vd, 8*vd)*dt
                    set CAM.r = ifs {
                        HELD.right > 0 => lerp_angle_dt(0.01, dt, CAM.r, math.pi/256)
                        HELD.left > 0  => lerp_angle_dt(0.01, dt, CAM.r, -math.pi/256)
                        else           => lerp_angle_dt(0.005, dt, CAM.r, 0)
                    }
                }
                body_set(u.b, :angle, u.r)
            }
        } with {
            ;; the walls: it bounces, and the followers feel it in turn
            loop e on :collision.enter until (it.b == u.b) && (it.other.kind == :wall) {
                spawn @fxs HfxUse(u.hit, 0.5, 200, 10, 0.1)
                spring_shake(2, math.pi - u.r)
                bounce(u, e.nx, e.ny)
                val p = rfloat(0.9, 1.1)
                play(player_hit_wall1, [pitch=p, volume=0.1])
                play(pop1, [pitch=p, volume=0.2])
                loop i, f in A.units {
                    if i > 0 {
                        spawn {
                            await((i*(10.6/u.v)) * 1s)
                            spawn HfxUse(f.hit, 0.5, 200, 10, 0.1)
                            play(player_hit_wall1, [pitch=p + 0.025*i, volume=0.1])
                            play(pop1, [pitch=p + 0.05*i, volume=0.2])
                        }
                    }
                }
            }
        }
    }

    ;; death, as the end of `Player:hit`
    trace("unit.die", u.character)
    play(hit4, [pitch=rfloat(0.95, 1.05), volume=0.5])
    slow(0.25, 1)
    loop _ in rint(4, 6) {
        spawn @fx HitParticle(u.x, u.y, [color=u.color])
    }
    spawn @fx HitCircle(u.x, u.y, [rs=12, scale_down=true, duration=0.3, change_color=[0.5, u.color]])
    snake_remove(A, u)
}

;; The place of a follower on the path of the leader, 10.4 pixels per
;; place behind it, or nil if the path is not that long yet.
func snake_place (A, u) {
    val target = 10.4*u.index
    var sum = 0
    var prev = A.units@0
    var p = nil
    loop i, q in A.path {
        set sum += math.sqrt((prev.x - q.x)*(prev.x - q.x) + (prev.y - q.y)*(prev.y - q.y))
        if sum >= target {
            set p = A.path@(i-1)
            break
        }
        set prev = q
    }
    p
}

;; Removes a dead unit from the snake, as `recalculate_followers`: the
;; units behind it move up a place, and if it was the leader, the next
;; one becomes the leader (`:Snake.lead`), with a new path.
func snake_remove (A, u) {
    val was_leader = A.units@0 == u
    val us = []
    loop _, o in A.units {
        if o != u {
            set us@+ = o
        }
    }
    set A.units = us
    loop i, o in us {
        set o.index = i
    }
    ifs {
        #us == 0 => emit @:global :Arena.died
        was_leader => {
            set A.path = []
            emit @:global :Snake.lead [ u=us@0 ]
        }
    }
}
