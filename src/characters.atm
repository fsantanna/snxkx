;; The characters of the units, as the branches of `Player:init` of the
;; original (`player.lua:5-1145`) for ten of them, one of each kind:
;;
;;   projectiles:   vagrant, archer, scout, outlaw, wizard
;;   areas:         swordsman, magician
;;   healing:       cleric
;;   buff:          squire
;;   summon:        sentry
;;
;; Each attack of the original is `t:cooldown(d, condition, action)`:
;; here, a loop that awaits the cooldown, then a target, then acts.

;; As `Player:shoot(r, mods)`: projectiles along `r`, with a kick of the
;; camera and of the unit. A rogue may crit, a ranger may barrage after
;; the shot. The outlaw throws five, in a fan.
task Shoot (A, u, r, mods, fx, shots) {
    spring_shake(2, r)
    spawn @fx HfxUse(u.shoot, 0.25)
    var dmg_m = 1
    var crit = false
    if u.character == "beastmaster" {
        set crit = rbool(10)
    }
    if u.chance_to_crit && rbool(u.chance_to_crit) {
        set dmg_m = match u.assassination { 1 => 8 ; 2 => 10 ; 3 => 12 ; else => 4 }
        set crit = true
        trace("crit", u.character)
    }
    if u.assassination && has_class(u, "rogue") && !crit {
        set dmg_m = 0.5
    }
    if u.character == "thief" {
        set dmg_m = dmg_m*2
        if (u.level == 3) && crit {
            set dmg_m = dmg_m*10
            set A.gold_picked_up += 1
        }
    }
    if crit && mods && mods.spawn_critters_on_crit {
        play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        loop _ in mods.spawn_critters_on_crit {
            spawn @shots Critter(A, u.x, u.y, rfloat(0, 2*math.pi), 10, u.dmg, u, fx)
        }
    }
    val o = [ dmg=u.dmg*dmg_m, crit=crit ] ++ (mods || [])
    match u.character {
        "outlaw" => {
            spawn @fx HitCircle(u.x + 0.8*9*math.cos(r), u.y + 0.8*9*math.sin(r), [rs=6])
            var a = r - 2*math.pi/8
            loop _ in 5 {
                spawn @shots Projectile(A, shoot_args(u, a, o), fx)
                set a += math.pi/8
            }
        }
        "blade" => {
            ;; a knife at each enemy around
            loop _, e in enemies_in_circle(A, u.x, u.y, 64) {
                val a = angle_to(u, e.x, e.y)
                spawn @fx HitCircle(u.x + 0.8*9*math.cos(a), u.y + 0.8*9*math.sin(a), [rs=6])
                spawn @shots Projectile(A, shoot_args(u, a, o), fx)
            }
        }
        "sage" => {
            spawn @fx HitCircle(u.x + 0.8*9*math.cos(r), u.y + 0.8*9*math.sin(r), [rs=6])
            spawn @shots Projectile(A, shoot_args(u, r, [v=25, dmg=u.dmg, pierce=1000] ++ (mods || [])), fx)
        }
        "dual_gunner" => {
            loop _, side in [-math.pi/2, math.pi/2] {
                spawn @fx HitCircle(u.x + 0.8*9*math.cos(r) + 4*math.cos(r + side), u.y + 0.8*9*math.sin(r) + 4*math.sin(r + side), [rs=6])
                spawn @shots Projectile(A, shoot_args(u, r, [v=300] ++ o) ++ [
                    x = u.x + 1.6*9*math.cos(r) + 4*math.cos(r + side),
                    y = u.y + 1.6*9*math.sin(r) + 4*math.sin(r + side) ], fx)
            }
            set u.dg_counter = (u.dg_counter || 0) + 1
            if (u.dg_counter == 5) && (u.level == 3) {
                set u.dg_counter = 0
                spawn @shots GunKata(A, u, r, mods, fx, shots)
            }
        }
        else => {
            spawn @fx HitCircle(u.x + 0.8*9*math.cos(r), u.y + 0.8*9*math.sin(r), [rs=6])
            spawn @shots Projectile(A, shoot_args(u, r, o), fx)
        }
    }
    shoot_sound(u.character)
    if u.chance_to_barrage && rbool(u.chance_to_barrage) {
        await Barrage(A, u, r, 3, [], fx, shots)
    }
}

;; The gun kata of the dual gunner of level 3, every fifth shot: 20 shots
;; at random enemies around, 0.1s apart (`every(0.1, ..., 20)`).
task GunKata (A, u, r, mods, fx, shots) {
    loop _ in 20 {
        await 100ms
        val e = random_enemy(A, u.x, u.y, 96)
        if e {
            play(rtable([gun_kata1, gun_kata2]), [pitch=rfloat(0.95, 1.05), volume=0.35])
            spring_shake(2, r)
            spawn @fx HfxUse(u.shoot, 0.25)
            val a = angle_to(u, e.x, e.y)
            spawn @fx HitCircle(u.x + 0.8*9*math.cos(a) + 4*math.cos(a - math.pi/2), u.y + 0.8*9*math.sin(a) + 4*math.sin(a - math.pi/2), [rs=6])
            spawn @shots Projectile(A, shoot_args(u, a, [v=300] ++ (mods || [])), fx)
        }
    }
}

;; As `Player:barrage(r, n, pierce, ricochet, shoot_5, homing)`: `n`
;; arrows, 0.075s apart, spread a little around `r`.
task Barrage (A, u, r, n, o, fx, shots) {
    trace("barrage", u.character)
    loop i in (n || 8) {
        if i > 0 {
            await 75ms
        }
        play(archer1, [pitch=rfloat(0.95, 1.05), volume=(if o.shoot_5 => 0.2 => 0.35)])
        spawn @fx HitCircle(u.x + 0.8*9*math.cos(r), u.y + 0.8*9*math.sin(r), [rs=6])
        spawn @shots Projectile(A, [x=u.x + 1.6*9*math.cos(r), y=u.y + 1.6*9*math.sin(r), v=250,
            r=r + rfloat(-math.pi/16, math.pi/16), color=u.color, dmg=u.dmg, parent=u, character="barrage",
            level=u.level, pierce=o.pierce || 0, ricochet=o.ricochet || 0, shoot_5=o.shoot_5, homing=o.homing], fx)
    }
}

;; As `Player:attack(area, mods)`: an area at the unit, or at `mods.x`,
;; `mods.y`; `mods` may also stun or push (`stun`, `juggernaut_push`).
task Attack (A, u, size, mods, fx) {
    shake(2, 0.5)
    spawn @fx HfxUse(u.shoot, 0.25)
    val m = mods || []
    spawn @fx Area(A, [x=m.x || u.x, y=m.y || u.y, r=u.r, w=u.area_size_m*(size || 64), color=u.color,
                       dmg=u.area_dmg_m*u.dmg, character=u.character, level=u.level, parent=u,
                       stun=m.stun, juggernaut_push=m.juggernaut_push], fx)
    val c = u.character
    ifs {
        X.xin(c, ["swordsman", "barbarian", "juggernaut", "highlander"]) =>
            play(rtable([swordsman1, swordsman2]), [pitch=rfloat(0.9, 1.1), volume=0.75])
        c == "elementor" => play(elementor1, [pitch=rfloat(0.9, 1.1), volume=0.5])
        c == "psychic" => play(psychic1, [pitch=rfloat(0.9, 1.1), volume=0.4])
        c == "launcher" => play(buff1, [pitch=rfloat(0.9, 1.1), volume=0.5])
    }
    if c == "juggernaut" {
        play(elementor1, [pitch=rfloat(0.9, 1.1), volume=0.5])
    }
}

;; As `Player:dot_attack(area, mods)`: a damage over time area at the unit
;; (after `d` seconds, for a repeat).
task DotAttack (A, u, size, mods, fx, d) {
    await(d * 1s)
    shake(2, 0.5)
    spawn @fx HfxUse(u.shoot, 0.25)
    spawn @fx DotArea(A, [x=u.x, y=u.y, r=u.r, rs=u.area_size_m*(size || 64), color=u.color,
        dmg=u.area_dmg_m*u.dmg*(u.dot_dmg_m || 1), character=u.character, level=u.level, parent=u] ++ (mods || []), fx)
    play(dot1, [pitch=rfloat(0.9, 1.1), volume=0.5])
}

;; The enemies a curser curses: a random few of those within 128, as
;; `table.first2(table.shuffle(...), n)`, `n` more with the cursers.
func curse_targets (A, u, n) {
    val es = enemies_in_circle(A, u.x, u.y, 128)
    val out = []
    loop _ in math.min(n + (match A.cl.curser { 2 => 3 ; 1 => 1 ; else => 0 })
                         + (match u.malediction { 1 => 1 ; 2 => 3 ; 3 => 5 ; else => 0 }), #es) {
        set out@+ = rtable_remove(es)
    }
    out
}

;; A place in the arena with no body on it, as the cleric looks for one.
func free_place (A) {
    var x, y = 0, 0
    loop {
        set x = rfloat(A.x1 + 16, A.x2 - 16)
        set y = rfloat(A.y1 + 16, A.y2 - 16)
        var free = true
        loop _, e in A.enemies {
            if circle_hits(x, y, 2, e) {
                set free = false
            }
        }
        until free
    }
    return x, y
}

;; As `HealingOrb`: an orb that drifts, is drawn to the units near it,
;; and heals the unit with the least hp (in proportion) that takes it.
task HealingOrb (A, x, y, fx) {
    val o = [ kind=:orb, w=4, h=4, x=x, y=y, r=0, hit=hfx(1) ]
    body(A.w, o, :dynamic, x, y, :ghost, [:rect, 4, 4])
    defer {
        body_free(A.w, o.b)
    }
    body_restitution(o.b, 0.5)
    val r = rfloat(0, 2*math.pi)
    val f = rfloat(2, 4)
    body_set(o.b, :impulse, f*math.cos(r), f*math.sin(r))
    body_set(o.b, :angular_impulse, rtable([rfloat(-6*math.pi, -2*math.pi), rfloat(2*math.pi, 6*math.pi)]))
    body_set(o.b, :damping, 2.5)
    body_set(o.b, :angular_damping, 5)
    play(illusion1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    spawn Springs(o.hit.s)
    spawn {
        loop on :draw {
            val sr = rfloat(-0.1, 0.1)
            eng.push(o.x, o.y, o.r, o.hit.s.x + sr)
            eng.circle(o.x, o.y, 1.2*4, if o.hit.f > 0 => fg@0 => alpha(green@0, 0.25))
            eng.circle(o.x, o.y, 0.5*4, if o.hit.f > 0 => fg@0 => green@0)
            eng.pop()
        }
    }
    spawn {
        loop on :clock {
            set o.x, o.y = body_pos(o.b)
            set o.r = body_angle(o.b)
            var n, sx, sy = 0, 0, 0
            loop _, u in A.units {
                if circle_hits(o.x, o.y, 16, u) {
                    set n += 1
                    set sx += u.x
                    set sy += u.y
                }
            }
            if n > 0 {
                val a = math.atan2(sy/n - o.y, sx/n - o.x)
                body_set(o.b, :force, 20*math.cos(a), 20*math.sin(a))
            }
        }
    }
    ;; it cannot be taken in its first 0.5s
    await 500ms
    await :trigger.enter until (it.b == o.b) && (it.other.kind == :player)
    spawn @fx HitCircle(o.x, o.y, [rs=4, color=fg@0, duration=0.1])
    loop _ in 2 {
        spawn @fx HitParticle(o.x, o.y, [color=green@0])
    }
    play(orb1, [pitch=rfloat(0.95, 1.05), volume=1])
    play(heal1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    var low = nil
    var lr = 10
    loop _, u in A.units {
        val q = u.hp/u.max_hp
        if q < lr {
            set lr = q
            set low = u
        }
    }
    if low {
        emit @:global :Heal [ to=low, amount=0.2*low.max_hp ]
    }
}

;; As `Sentry`: a cross that turns, shoots four arrows every 2.75 to 3.5s,
;; and lasts 15s.
task Sentry (A, u, fx, shots) {
    val s = [ kind=:sentry, w=6, h=6, x=u.x, y=u.y, r=0, color=u.color, hit=hfx(1), dmg=u.dmg,
              area_size_m=u.area_size_m, area_dmg_m=u.area_dmg_m ]
    body(A.w, s, :static, s.x, s.y, :player, [:rect, 6, 6])
    defer {
        body_free(A.w, s.b)
    }
    val sp = spring(1)
    spawn Springs(sp, s.hit.s)
    spawn {
        loop on :draw {
            eng.push(s.x, s.y, s.r, sp.x)
            eng.rect(s.x, s.y, 12, 4, 2, 2, if s.hit.f > 0 => fg@0 => s.color)
            eng.rect(s.x, s.y, 4, 12, 2, 2, if s.hit.f > 0 => fg@0 => s.color)
            eng.pop()
        }
    }
    spawn {
        loop us on :clock {
            set s.r += math.pi*(us/1000000)
            body_set(s.b, :angle, s.r)
        }
    }
    par :any {
        await 15s
    } with {
        loop {
            await((rfloat(2.75, 3.5)*(if u.level == 3 => 0.75 => 1)) * 1s)
            spawn @fx HfxUse(s.hit, 0.25, 200, 10)
            var r = s.r
            loop _ in 4 {
                play(archer1, [pitch=rfloat(0.95, 1.05), volume=0.35])
                spawn @fx HitCircle(s.x + 0.8*6*math.cos(r), s.y + 0.8*6*math.sin(r), [rs=6])
                spawn @shots Projectile(A, [x=s.x + 1.6*6*math.cos(r), y=s.y + 1.6*6*math.sin(r), v=200, r=r,
                    color=s.color, dmg=u.dmg, character="sentry", parent=s, level=u.level,
                    ricochet=(if u.level == 3 => 2 => 0)], fx)
                set r += math.pi/2
            }
        }
    }
    loop _ in rint(3, 4) {
        spawn @fx HitParticle(s.x, s.y, [r=rfloat(0, 2*math.pi), color=s.color])
    }
    spawn @fx HitCircle(s.x, s.y, [scale_down=true])
}

;; The behavior of a unit by its character, while the unit lives.
task Character (A, u, fx, shots) {
    pin acts = tasks()          ;; the attacks, which live with the unit
    val near = \(rs) { #enemies_in_circle(A, u.x, u.y, rs) > 0 }
    val toward = \(e) { math.atan2(e.y - u.y, e.x - u.x) }
    match u.character {
        "vagrant" => loop {
            await Cooldown(u, 2, \{ near(96) })
            val e = closest_enemy(A, u.x, u.y, 96)
            if e { spawn @acts Shoot(A, u, toward(e), [], fx, shots) }
        }
        "archer" => loop {
            await Cooldown(u, 2, \{ near(160) })
            val e = closest_enemy(A, u.x, u.y, 160)
            if e { spawn @acts Shoot(A, u, toward(e), [pierce=1000, ricochet=(if u.level == 3 => 3 => 0)], fx, shots) }
        }
        "scout" => loop {
            await Cooldown(u, 2, \{ near(64) })
            val e = closest_enemy(A, u.x, u.y, 64)
            if e { spawn @acts Shoot(A, u, toward(e), [chain=(if u.level == 3 => 6 => 3)], fx, shots) }
        }
        "outlaw" => loop {
            await Cooldown(u, 3, \{ near(96) })
            val e = closest_enemy(A, u.x, u.y, 96)
            if e { spawn @acts Shoot(A, u, toward(e), [homing=(u.level == 3)], fx, shots) }
        }
        "wizard" => loop {
            await Cooldown(u, 2, \{ near(128) })
            val e = closest_enemy(A, u.x, u.y, 128)
            if e { spawn @acts Shoot(A, u, toward(e), [chain=(if u.level == 3 => 2 => 0)], fx, shots) }
        }
        "swordsman" => loop {
            await Cooldown(u, 3, \{ near(48) })
            spawn @acts Attack(A, u, 96, nil, fx)
        }
        "magician" => loop {
            await Cooldown(u, 2, \{ near(96) })
            val e = random_enemy(A, u.x, u.y, 96)
            if e { spawn @acts Attack(A, u, 32, [x=e.x, y=e.y], fx) }
        }
        "thief" => loop {
            await Cooldown(u, 2, \{ near(64) })
            val e = closest_enemy(A, u.x, u.y, 64)
            if e { spawn @acts Shoot(A, u, toward(e), [chain=(if u.level == 3 => 10 => 5)], fx, shots) }
        }
        "blade" => loop {
            await Cooldown(u, 4, \{ near(64) })
            spawn @acts Shoot(A, u, 0, [], fx, shots)
        }
        "sage" => loop {
            await Cooldown(u, 9, \{ near(96) })
            val e = closest_enemy(A, u.x, u.y, 96)
            if e { spawn @acts Shoot(A, u, toward(e), [], fx, shots) }
        }
        "cannoneer" => loop {
            await Cooldown(u, 6, \{ near(128) })
            val e = closest_enemy(A, u.x, u.y, 128)
            if e { spawn @acts Shoot(A, u, toward(e), [], fx, shots) }
        }
        "dual_gunner" => loop {
            await Cooldown(u, 2, \{ near(96) })
            val e = closest_enemy(A, u.x, u.y, 96)
            if e { spawn @acts Shoot(A, u, toward(e), [], fx, shots) }
        }
        "hunter" => loop {
            await Cooldown(u, 2, \{ near(160) })
            val e = closest_enemy(A, u.x, u.y, 160)
            if e { spawn @acts Shoot(A, u, toward(e), [], fx, shots) }
        }
        "spellblade" => do {
            val tk = [ t=0 ]
            loop {
                await Every(u, 2, tk)
                spawn @acts Shoot(A, u, rfloat(0, 2*math.pi), [], fx, shots)
            }
        }
        "lich" => loop {
            await Cooldown(u, 4, \{ near(128) })
            val e = closest_enemy(A, u.x, u.y, 128)
            if e { spawn @acts Shoot(A, u, toward(e), [chain=(if u.level == 3 => 14 => 7), v=140], fx, shots) }
        }
        "corruptor" => loop {
            await Cooldown(u, 2, \{ near(160) })
            val e = closest_enemy(A, u.x, u.y, 160)
            if e { spawn @acts Shoot(A, u, toward(e), [spawn_critters_on_kill=3,
                       spawn_critters_on_hit=(if u.level == 3 => 2 => nil)], fx, shots) }
        }
        "beastmaster" => loop {
            await Cooldown(u, 2, \{ near(160) })
            val e = closest_enemy(A, u.x, u.y, 160)
            if e { spawn @acts Shoot(A, u, toward(e), [spawn_critters_on_crit=2], fx, shots) }
        }
        "assassin" => loop {
            await Cooldown(u, 2, \{ near(64) })
            val e = closest_enemy(A, u.x, u.y, 64)
            if e { spawn @acts Shoot(A, u, toward(e), [pierce=1000], fx, shots) }
        }
        "barrager" => do {
            var n = 0
            loop {
                await Cooldown(u, 4, \{ near(128) })
                val e = closest_enemy(A, u.x, u.y, 128)
                val r = toward(e)
                set n += 1
                if (n == 3) && (u.level == 3) {
                    set n = 0
                    spawn @acts Volley(A, u, r, 15, 0.05, [knockback=14], fx, shots)
                } else {
                    spawn @acts Volley(A, u, r, 3, 0.075, [knockback=(if u.level == 3 => 14 => 7)], fx, shots)
                }
            }
        }
        "arcanist" => loop {
            await Cooldown(u, 4, \{ near(128) })
            val e = closest_enemy(A, u.x, u.y, 128)
            if e {
                val r = toward(e)
                spawn @acts Shoot(A, u, r, [pierce=10000, v=40], fx, shots)
                if sorcerer_due(A, u) {
                    spawn @acts Later(0.25, \{ toward(e) }, A, u, [pierce=10000, v=40], fx, shots)
                }
            }
        }
        "artificer" => loop {
            await 6s
            spawn @acts Construct(A, u, 0, fx, shots)
            if sorcerer_due(A, u) {
                spawn @acts Construct(A, u, 0.25, fx, shots)
            }
        }
        "elementor" => loop {
            await Cooldown(u, 7, \{ near(128) })
            val e = random_enemy(A, u.x, u.y, 128)
            if e { spawn @acts Attack(A, u, 128, [x=e.x, y=e.y], fx) }
        }
        "psychic" => do {
            val rs = if u.level == 3 => 512 => 64
            loop {
                await Cooldown(u, 3, \{ near(rs) })
                spawn @acts PsychicStrike(A, u, rs, 0, fx)
                if sorcerer_due(A, u) {
                    spawn @acts PsychicStrike(A, u, rs, 0.1, fx)
                }
            }
        }
        "barbarian" => loop {
            await Cooldown(u, 8, \{ near(48) })
            spawn @acts Attack(A, u, 96, [stun=4], fx)
        }
        "juggernaut" => loop {
            await Cooldown(u, 8, \{ near(64) })
            spawn @acts Attack(A, u, 128, [juggernaut_push=true], fx)
        }
        "highlander" => loop {
            await Cooldown(u, 4, \{ near(36) })
            if u.level == 3 {
                spawn @acts Strikes(A, u, fx)
            } else {
                spawn @acts Attack(A, u, 72, nil, fx)
            }
        }
        "launcher" => loop {
            await Cooldown(u, 6, \{ near(96) })
            play(buff1, [pitch=rfloat(0.9, 1.1), volume=0.5])
            loop _, e in A.enemies {
                if math.sqrt((e.x - u.x)*(e.x - u.x) + (e.y - u.y)*(e.y - u.y)) < 128 {
                    curse(e, :launcher, 4*(u.hex_duration_m || 1), if u.level == 3 => 6*u.dmg => 2*u.dmg, u)
                    spawn @fx HitCircle(u.x, u.y, [rs=6, color=yellow@0, duration=0.1])
                    spawn @fx LightningLine(u, e, yellow@0, fx)
                }
            }
        }
        "jester" => loop {
            await Cooldown(u, 6, \{ near(96) })
            play(buff1, [pitch=rfloat(0.9, 1.1), volume=0.5])
            loop _, e in curse_targets(A, u, 6) {
                curse(e, :jester, 6*(u.hex_duration_m || 1), u.level == 3, u)
                spawn @fx HitCircle(u.x, u.y, [rs=6, color=red@0, duration=0.1])
                spawn @fx LightningLine(u, e, red@0, fx)
            }
        }
        "bane" => loop {
            await Cooldown(u, 6, \{ near(96) })
            play(buff1, [pitch=rfloat(0.9, 1.1), volume=0.5])
            loop _, e in curse_targets(A, u, 6) {
                curse(e, :bane, 6*(u.hex_duration_m || 1), u.level == 3, u)
                spawn @fx HitCircle(u.x, u.y, [rs=6, color=purple@0, duration=0.1])
                spawn @fx LightningLine(u, e, purple@0, fx)
            }
        }
        "infestor" => loop {
            await Cooldown(u, 6, \{ near(96) })
            play(buff1, [pitch=rfloat(0.9, 1.1), volume=0.5])
            loop _, e in curse_targets(A, u, 8) {
                curse(e, :infestor, 6*(u.hex_duration_m || 1), if u.level == 3 => 6 => 2, u.dmg, u)
                spawn @fx HitCircle(u.x, u.y, [rs=6, color=orange@0, duration=0.1])
                spawn @fx LightningLine(u, e, orange@0, fx)
            }
        }
        "usurer" => loop {
            await Cooldown(u, 6, \{ near(96) })
            play(buff1, [pitch=rfloat(0.9, 1.1), volume=0.5])
            loop _, e in curse_targets(A, u, 3) {
                curse(e, :usurer, 10000, u.level == 3, u)
                dot(e, u.dmg*(u.dot_dmg_m || 1)*(A.chronomancer_dot || 1), 10000)
                spawn @fx HitCircle(u.x, u.y, [rs=6, color=purple@0, duration=0.1])
                spawn @fx LightningLine(u, e, purple@0, fx)
            }
        }
        "silencer" => loop {
            await Cooldown(u, 6, \{ near(96) })
            spawn @acts Silence(A, u, 0, fx)
            if sorcerer_due(A, u) {
                spawn @acts Silence(A, u, 0.5, fx)
            }
        }
        "witch" => do {
            val tk = [ t=0 ]
            loop {
                await Every(u, 4, tk)
                spawn @acts DotAttack(A, u, 42, [duration=rfloat(12, 16)], fx, 0)
                if sorcerer_due(A, u) {
                    spawn @acts DotAttack(A, u, 42, [duration=rfloat(12, 16)], fx, 0.25)
                }
            }
        }
        "plague_doctor" => do {
            if u.level == 3 {
                spawn @fx DotArea(A, [x=u.x, y=u.y, rs=u.area_size_m*48, color=u.color, dmg=u.area_dmg_m*u.dmg,
                                      character=u.character, level=u.level, parent=u], fx)
            }
            val tk = [ t=0 ]
            loop {
                await Every(u, 5, tk)
                spawn @acts DotAttack(A, u, 24, [duration=12, plague_doctor_unmovable=true], fx, 0)
            }
        }
        "cryomancer" => do {
            spawn @fx DotArea(A, [x=u.x, y=u.y, rs=u.area_size_m*72, color=u.color, dmg=u.area_dmg_m*u.dmg,
                                  character=u.character, level=u.level, parent=u], fx)
            await(false)
        }
        "pyromancer" => do {
            spawn @fx DotArea(A, [x=u.x, y=u.y, rs=u.area_size_m*48, color=u.color, dmg=u.area_dmg_m*u.dmg,
                                  character=u.character, level=u.level, parent=u], fx)
            await(false)
        }
        "psykino" => do {
            val tk = [ t=0 ]
            loop {
                await Every(u, 4, tk)
                val e = random_enemy(A, u.x, u.y, 160)
                if e {
                    spawn @fx ForceArea(A, [x=e.x, y=e.y, rs=u.area_size_m*64, color=u.color,
                                            character=u.character, level=u.level, parent=u], fx)
                }
            }
        }
        "vulcanist" => do {
            val tk = [ t=0 ]
            loop {
                await Every(u, 12, tk)
                spawn @acts Erupt(A, u, 0, fx)
                if sorcerer_due(A, u) {
                    spawn @acts Erupt(A, u, 0.5, fx)
                }
            }
        }
        "saboteur" => loop {
            await 8s
            spawn @acts Saboteurs(A, u, fx)
        }
        "bomber" => loop {
            await 8s
            spawn @acts BombDrop(A, u, fx)
        }
        "carver" => loop {
            await 16s
            spawn @fx Tree(A, u.x, u.y, u, fx)
        }
        "engineer" => do {
            if u.level == 3 {
                spawn @acts Upgrades(A, u, fx, shots)
            }
            loop {
                await 8s
                spawn @acts TurretDrop(A, u, u.x, u.y, fx, shots)
            }
        }
        "host" => loop {
            await((if u.level == 3 => 1 => 2) * 1s)
            play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.35])
            loop _ in (if u.level == 3 => 2 => 1) {
                spawn @shots Critter(A, u.x, u.y, rfloat(0, 2*math.pi), 10, u.dmg, u, fx)
            }
        }
        "gambler" => do {
            val tk = [ t=0 ]
            loop {
                await Every(u, 2, tk)
                spawn @acts Gamble(A, u, fx)
            }
        }
        "stormweaver" => loop {
            await 8s
            play(stormweaver1, [pitch=rfloat(0.95, 1.05), volume=0.5])
            loop _, o in A.units {
                emit @:global :Infuse [ to=o, d=4 ]
            }
        }
        "chronomancer" => do {
            if u.level == 3 {
                set A.chronomancer_dot = 0.5
            }
            await(false)
        }
        "fairy" => loop {
            await 6s
            spawn @acts Bless(A, u, fx)
        }
        "warden" => loop {
            await 12s
            spawn @acts Ward(A, u, 0, fx)
            if sorcerer_due(A, u) {
                spawn @acts Ward(A, u, 0.5, fx)
            }
        }
        "priest" => do {
            if u.level == 3 {
                val us = []
                loop _, o in A.units {
                    set us@+ = o
                }
                loop _ in math.min(3, #us) {
                    set (rtable_remove(us)).divined = true
                }
            }
            loop {
                await 12s
                val x = rfloat(A.x1 + 16, A.x2 - 16)
                val y = rfloat(A.y1 + 16, A.y2 - 16)
                loop _ in 3 {
                    spawn @fx HealAt(A, x, y, fx)
                }
            }
        }
        "flagellant" => loop {
            await 8s
            play(buff1, [pitch=rfloat(0.95, 1.05), volume=0.3])
            play(flagellant1, [pitch=rfloat(0.95, 1.05), volume=0.4])
            loop _, o in A.units {
                if o.character == "flagellant" {
                    play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.4])
                    hit(o, 2*o.dmg)             ;; `self.level == unit.dmg or 2*unit.dmg`
                }
                set o.flagellant_dmg_m = (o.flagellant_dmg_m || 1) + (if u.level == 3 => 0.12 => 0.04)
            }
        }
        "cleric" => loop {
            await 8s
            loop _ in (if u.level == 3 => 4 => 1) {
                val x, y = free_place(A)
                spawn @fx HealAt(A, x, y, fx)
            }
        }
        "sentry" => loop {
            await 7s
            spawn @shots Sentry(A, u, fx, shots)
        }
        else => await(false)       ;; the squire buffs (see `unit_buffs`)
    }
}

;; Shots one after the other, a little spread (`t:after((i-1)*gap, ...)`).
task Volley (A, u, r, n, gap, mods, fx, shots) {
    pin ss = tasks()
    loop i in n {
        if i > 0 {
            await(gap * 1s)
        }
        spawn @ss Shoot(A, u, r + rfloat(-math.pi/32, math.pi/32), mods, fx, shots)
    }
    await :all ss
}

;; A shot again after `d` seconds, as the repeat of a sorcerer.
task Later (d, r, A, u, mods, fx, shots) {
    await(d * 1s)
    await Shoot(A, u, r(), mods, fx, shots)
}

;; The artificer builds an automaton where it is, at the peak of a spawn
;; effect, if no enemy is there (after `d` seconds, for a repeat).
task Construct (A, u, d, fx, shots) {
    await(d * 1s)
    val x, y = u.x, u.y
    await SpawnEffect(x, y, u.color, fx)
    play(artificer1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    if #enemies_in_circle(A, u.x, u.y, 2) == 0 {
        spawn @shots Automaton(A, x, y, u, fx, shots)
    }
}

;;; THE ATTACKS OF THE CHARACTERS ;;;

;; The psychic strikes a random enemy around it with a small area (and
;; another one 0.5s later at level 3).
task PsychicStrike (A, u, rs, d, fx) {
    await(d * 1s)
    val e = random_enemy(A, u.x, u.y, rs)
    if e {
        await Attack(A, u, 32, [x=e.x, y=e.y], fx)
        if u.level == 3 {
            await 500ms
            val e2 = random_enemy(A, u.x, u.y, rs)
            if e2 {
                await Attack(A, u, 32, [x=e2.x, y=e2.y], fx)
            }
        }
    }
}

;; The highlander of level 3 strikes three times, 0.25s apart.
task Strikes (A, u, fx) {
    loop _ in 3 {
        await 250ms
        await Attack(A, u, 72, nil, fx)
    }
}

;; The silencer silences a few enemies around it (and damages them over
;; time at level 3).
task Silence (A, u, d, fx) {
    await(d * 1s)
    play(buff1, [pitch=rfloat(0.9, 1.1), volume=0.5])
    loop _, e in curse_targets(A, u, 6) {
        curse(e, :silencer, 6*(u.hex_duration_m || 1), u.level == 3, u)
        if u.level == 3 {
            dot(e, u.dmg*(u.dot_dmg_m || 1)*(A.chronomancer_dot || 1), 6*(u.hex_duration_m || 1))
        }
        spawn @fx HitCircle(u.x, u.y, [rs=6, color=blue2@0, duration=0.1])
        spawn @fx LightningLine(u, e, blue2@0, fx)
    }
}

;; Whether nothing is at a place (a unit, an enemy, a critter).
func free_at (A, x, y, rs) {
    var free = true
    loop _, l in [A.units, A.enemies, A.critters] {
        loop _, o in l {
            if circle_hits(x, y, rs, o) {
                set free = false
            }
        }
    }
    free
}

;; The vulcanist raises a volcano halfway between itself and the middle
;; of the enemies, as soon as the place is free (tried every 0.1s).
task Erupt (A, u, d, fx) {
    await(d * 1s)
    var x, y = 0, 0
    if #A.enemies > 0 {
        loop _, e in A.enemies {
            set x += e.x
            set y += e.y
        }
        set x = x/#A.enemies
        set y = y/#A.enemies
    }
    if (x == 0) && (y == 0) {
        set x, y = W/2, H/2
    }
    set x, y = (x + u.x)/2, (y + u.y)/2
    loop {
        until free_at(A, x, y, 2)
        await 100ms
    }
    spawn @fx Volcano(A, x, y, u, fx)
}

;; The saboteur calls two saboteurs, 0.25s apart, each out of a spawn
;; effect at itself.
task Saboteurs (A, u, fx) {
    pin ss = tasks()
    loop _ in 2 {
        await 250ms
        spawn @ss SaboteurDrop(A, u, fx)
    }
    await :all ss
}

task SaboteurDrop (A, u, fx) {
    val x, y = u.x, u.y
    await SpawnEffect(x, y, u.color, fx)
    spawn @fx Saboteur(A, x, y, u, (u.level == 3) && rbool(50), fx)
}

task BombDrop (A, u, fx) {
    val x, y = u.x, u.y
    await SpawnEffect(x, y, u.color, fx)
    spawn @fx Bomb(A, x, y, u, fx)
}

task TurretDrop (A, u, x, y, fx, shots) {
    await SpawnEffect(x, y, orange@0, fx)
    spawn @shots Turret(A, x, y, u, fx, shots)
}

;; The engineer of level 3, every 24s: two more turrets, and all of them
;; upgraded.
task Upgrades (A, u, fx, shots) {
    pin ds = tasks()
    loop {
        await 24s
        spawn @ds TurretDrop(A, u, u.x - 16, u.y + 16, fx, shots)
        spawn @ds TurretDrop(A, u, u.x + 16, u.y + 16, fx, shots)
        await 500ms
        play(buff1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        loop _, t in A.turrets {
            spawn @fx HitCircle(u.x, u.y, [rs=6, color=orange@0, duration=0.1])
            spawn @fx LightningLine(u, t, orange@0, fx)
            emit @:global :Upgrade [ to=t ]
        }
    }
}

;; The gambler hits a random enemy for twice the gold of the run, with a
;; chance of more casts at level 3; the sorcerers repeat it.
task Gamble (A, u, fx) {
    pin cs = tasks()
    spawn @cs Cast(A, u, 1, 0)
    if (u.level == 3) && rbool(60) {
        val n = if rbool(40) => (if rbool(20) => 3 => 2) => 1
        loop i in n {
            spawn @cs Cast(A, u, 1.1 + i*0.1, 0.25*(i + 1))
        }
    }
    await :all cs
}

task Cast (A, u, pitch, d) {
    await(d * 1s)
    val gold = A.run && A.run.gold || 0
    val vol = math.max(0, math.min(remap(gold, 0, 50, 0, 0.5), 0.75))
    if #A.enemies > 0 {
        play(gambler1, [pitch=pitch, volume=vol])
        hit(rtable(A.enemies), 2*gold)
        if sorcerer_due(A, u) {
            await 250ms
            if #A.enemies > 0 {
                play(gambler1, [pitch=pitch + 0.05, volume=vol])
                hit(rtable(A.enemies), 2*gold)
            }
        }
    }
}

;; A unit that attacks, at random (the fairy skips the others).
func attacking_unit (A) {
    if #A.units == 0 {
        return nil
    }
    var u = rtable(A.units)
    var runs = 0
    loop {
        while X.xin(u.character, non_attacking_characters) && (runs < 1000)
        set u = rtable(A.units)
        set runs += 1
    }
    u
}

;; The fairy speeds up the attacks of one unit (two at level 3, more) for
;; 6s, and grows healing orbs (one, two at level 3).
task Bless (A, u, fx) {
    val n = if u.level == 3 => 2 => 1
    loop _ in n {
        val o = attacking_unit(A)
        if o {
            spawn @fx TimedBuff(o, "fairy_aspd_m", if u.level == 3 => 3 => 2, 5.98)
        }
    }
    play(heal1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    play(buff1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    loop _ in n {
        val x, y = free_place(A)
        spawn @fx HealAt(A, x, y, fx)
    }
}

;; The warden puts a force field around a random unit (two at level 3),
;; as soon as no enemy is on it (tried every 0.1s).
task Ward (A, u, d, fx) {
    await(d * 1s)
    val us = []
    loop _, o in A.units {
        set us@+ = o
    }
    if #us == 0 {
        return nil
    }
    if u.level == 3 {
        val u1 = rtable_remove(us)
        val u2 = if #us > 0 => rtable_remove(us) => nil
        play(illusion1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        spawn @fx WardWhenFree(A, u1, fx)
        if u2 {
            play(illusion1, [pitch=rfloat(0.95, 1.05), volume=0.5])
            spawn @fx ForceField(A, u2, fx)        ;; and another one when free, as the original
            spawn @fx WardWhenFree(A, u2, fx)
        }
    } else {
        play(illusion1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        spawn @fx WardWhenFree(A, rtable(us), fx)
    }
}

task WardWhenFree (A, o, fx) {
    loop {
        val busy = do {
            var b = false
            loop _, e in A.enemies {
                if circle_hits(o.x, o.y, 6, e) {
                    set b = true
                }
            }
            b
        }
        until !busy
        await 100ms
    }
    await ForceField(A, o, fx)
}

;; A spawn effect in green, and an orb at its peak if nothing is there.
task HealAt (A, x, y, fx) {
    await SpawnEffect(x, y, green@0, fx)
    var free = true
    loop _, e in A.enemies {
        if circle_hits(x, y, 2, e) {
            set free = false
        }
    }
    if free {
        await HealingOrb(A, x, y, fx)
    }
}

;; The characters that launch projectiles (`launches_projectiles`).
val PROJECTILE_CHARACTERS = ["vagrant", "archer", "scout", "outlaw", "blade", "wizard", "cannoneer",
    "dual_gunner", "hunter", "spellblade", "engineer", "corruptor", "beastmaster", "jester", "assassin",
    "barrager", "arcanist", "illusionist", "artificer", "miner", "thief", "sentry"]

;; The buffs of a unit, recomputed in every tick, as `Player:update`
;; (`player.lua:1147-1342`): each buff is a field of the unit, and the
;; stats multiply them. The squire and the chronomancer set their fields
;; on all units, and the fields stay when they die, as in the original.
;; The class levels of the arena (`A.cl`) are counted when it starts; the
;; vagrant and the explorer count the active sets of the living units.
func unit_buffs (A, u) {
    loop _, o in A.units {
        if o.character == "squire" {
            set u.squire_dmg_m = if o.level == 3 => 1.5 => 1.2
            set u.squire_def_m = if o.level == 3 => 1.5 => 1.2
            if o.level == 3 {
                set u.squire_aspd_m = 1.3
                set u.squire_mvspd_m = 1.3
            }
        }
        if o.character == "chronomancer" {
            set u.chronomancer_aspd_m = 1.2
        }
    }
    val cl = A.cl
    if (u.character == "vagrant") && (u.level == 3) {
        val n = active_sets(A.units)
        set u.vagrant_dmg_m = 1 + 0.1*n
        set u.vagrant_aspd_m = 1 + 0.1*n
    }
    if (u.character == "swordsman") && (u.level == 3) {
        set u.swordsman_dmg_m = 2
    }
    if (u.character == "outlaw") && (u.level == 3) {
        set u.outlaw_aspd_m = 1.5
    }
    if has_class(u, "ranger") {
        set u.chance_to_barrage = match cl.ranger { 2 => 16 ; 1 => 8 ; else => 0 }
    }
    if has_class(u, "warrior") {
        set u.warrior_def_a = match cl.warrior { 2 => 50 ; 1 => 25 ; else => 0 }
    }
    set u.heal_effect_m = 1
    if has_class(u, "nuker") {
        set u.nuker_area_size_m = match cl.nuker { 2 => 1.25 ; 1 => 1.15 ; else => 1 }
        set u.nuker_area_dmg_m = u.nuker_area_size_m
    }
    set u.conjurer_buff_m = match cl.conjurer { 2 => 1.5 ; 1 => 1.25 ; else => 1 }
    if has_class(u, "rogue") {
        set u.chance_to_crit = match cl.rogue { 2 => 30 ; 1 => 15 ; else => 0 }
    }
    set u.enchanter_dmg_m = match cl.enchanter { 2 => 1.25 ; 1 => 1.15 ; else => 1 }
    if has_class(u, "explorer") {
        val n = active_sets(A.units)
        set u.explorer_dmg_m = 1 + 0.15*n
        set u.explorer_aspd_m = 1 + 0.15*n
    }
    set u.knockback_m = match cl.forcer { 2 => 1.5 ; 1 => 1.25 ; else => 1 }
    set u.dot_dmg_m = 1
    if has_class(u, "voider") {
        set u.dot_dmg_m = match cl.voider { 2 => 1.4 ; 1 => 1.2 ; else => 1 }
    }
    if (u.character == "flagellant") && (u.level == 3) {
        set u.flagellant_hp_m = 2
    }
    ;; the passives (`player.lua:906-1000`, `1265-1325`)
    val i = do {
        var n = -1
        loop k, o in A.units {
            if o == u {
                set n = k
            }
        }
        n
    }
    if u.centipede {
        set u.centipede_mvspd_m = lv(u.centipede, 1.1, 1.2, 1.3)
    }
    if u.amplify {
        set u.amplify_area_dmg_m = lv(u.amplify, 1.2, 1.35, 1.5)
    }
    if u.ballista && X.xin(u.character, PROJECTILE_CHARACTERS) {
        set u.ballista_dmg_m = lv(u.ballista, 1.2, 1.35, 1.5)
    }
    if u.chronomancy && has_class(u, "mage") {
        set u.chronomancy_aspd_m = lv(u.chronomancy, 1.15, 1.25, 1.35)
    }
    if u.magnify {
        set u.magnify_area_size_m = lv(u.magnify, 1.2, 1.35, 1.5)
    }
    if u.berserking && has_class(u, "warrior") {
        set u.berserking_aspd_m = remap(u.hp/u.max_hp, 0, 1, lv(u.berserking, 1.5, 1.75, 2), 1)
    }
    if u.speed_3 && (i == 2) {
        set u.speed_3_aspd_m = 1.5
    }
    if u.damage_4 && (i == 3) {
        set u.damage_4_dmg_m = 1.3
    }
    ;; the stances: the leader and the last follower (they keep it)
    if (i == 0) || ((i > 0) && (i == (#A.units - 1))) {
        if u.defensive_stance {
            set u.defensive_stance_def_m = lv(u.defensive_stance, 1.1, 1.2, 1.3)
        }
        if u.offensive_stance {
            set u.offensive_stance_dmg_m = lv(u.offensive_stance, 1.1, 1.2, 1.3)
        }
    }
    if (i == 0) && (#A.units == 1) && u.last_stand {
        set u.last_stand_dmg_m = 1.2
        set u.last_stand_def_m = 1.2
        set u.last_stand_aspd_m = 1.2
        set u.last_stand_area_size_m = 1.2
        set u.last_stand_area_dmg_m = 1.2
        set u.last_stand_mvspd_m = 1.2
    }
    if u.dividends && has_class(u, "mercenary") {
        set u.dividends_dmg_m = 1 + (A.run.gold || 0)/100
    }
    if u.blessing {
        set u.heal_effect_m = lv(u.blessing, 1.1, 1.2, 1.3)
    }
    if u.haste {
        set u.haste_mvspd_m = if u.hasted => math.max(1, math.min(remap(eng.tick()/60 - u.hasted, 0, 4, 1.5, 1), 1.5)) => 1
    }
    ;; the leader holding left for more than 1s gives defense to all
    if (i == 0) && u.ouroboros_technique_l {
        val d = if held_for(:left, 1) => lv(u.ouroboros_technique_l, 1.15, 1.25, 1.35) => 1
        loop _, o in A.units {
            set o.ouroboros_def_m = d
        }
    }
    val m = \(k) { u@(k) || 1 }
    buffs_reset(u)
    set u.buff_def_a = u.warrior_def_a || 0
    set u.buff_aspd_m = m("chronomancer_aspd_m")*m("vagrant_aspd_m")*m("outlaw_aspd_m")*m("fairy_aspd_m")*
        m("psyker_aspd_m")*m("chronomancy_aspd_m")*m("awakening_aspd_m")*m("berserking_aspd_m")*m("reinforce_aspd_m")*
        m("squire_aspd_m")*m("speed_3_aspd_m")*m("last_stand_aspd_m")*m("enchanted_aspd_m")*m("explorer_aspd_m")*
        m("magician_aspd_m")
    set u.buff_dmg_m = m("squire_dmg_m")*m("vagrant_dmg_m")*m("enchanter_dmg_m")*m("swordsman_dmg_m")*
        m("flagellant_dmg_m")*m("psyker_dmg_m")*m("ballista_dmg_m")*m("awakening_dmg_m")*m("reinforce_dmg_m")*
        m("payback_dmg_m")*m("immolation_dmg_m")*m("damage_4_dmg_m")*m("offensive_stance_dmg_m")*m("last_stand_dmg_m")*
        m("dividends_dmg_m")*m("explorer_dmg_m")
    set u.buff_def_m = m("squire_def_m")*m("ouroboros_def_m")*m("unwavering_stance_def_m")*m("reinforce_def_m")*
        m("defensive_stance_def_m")*m("last_stand_def_m")*m("unrelenting_stance_def_m")*m("hardening_def_m")
    set u.buff_area_size_m = m("nuker_area_size_m")*m("magnify_area_size_m")*m("unleash_area_size_m")*m("last_stand_area_size_m")
    set u.buff_area_dmg_m = m("nuker_area_dmg_m")*m("amplify_area_dmg_m")*m("unleash_area_dmg_m")*m("last_stand_area_dmg_m")
    set u.buff_mvspd_m = m("wall_rider_mvspd_m")*m("centipede_mvspd_m")*m("squire_mvspd_m")*m("last_stand_mvspd_m")*m("haste_mvspd_m")
    set u.buff_hp_m = m("flagellant_hp_m")
}

;; A buff for a while: a field of the unit, back to 1 at the end (as
;; `t:after(d, function() u.field = 1 end)`).
task TimedBuff (u, k, v, d) {
    set u@(k) = v
    await(d * 1s)
    set u@(k) = 1
}
