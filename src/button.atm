;; A button of the interface, as `Button` of the original (in
;; `buy_screen.lua`): a rounded rectangle with a text, which bounces
;; and lights up while the mouse is over it.
;;
;; A click is not an action of the button: the button emits
;; `:Button.click [id, spring]` to the task `owner`, which decides what
;; follows. The button lives until its owner aborts it. With `opts.info`,
;; a text shows under it while the mouse is over it.

task Button (owner, id, x, y, label, opts) {
    val fg_color = opts && opts.fg_color || :bg10
    val bg_color = opts && opts.bg_color || bg
    val w = opts && opts.w || (text_width(pixul_font, label) + 8)
    val h = pixul_font.h + 4
    val s = spring(1)
    set pub = [ spring=s ]
    spawn UISprings(s)

    ;; the two looks of the button, out and over
    val t_out  = text([ [text="[" ++ fg_color ++ "]" ++ label, font=pixul_font, alignment=:center] ])
    val t_over = text([ [text="[fgm5]" ++ label, font=pixul_font, alignment=:center] ])
    val draw = func (color, t) {
        eng.push(x, y, 0, s.x)
        eng.rect(x, y, w, h, 4, 4, color)
        text_draw(t, x, y + 1, 0, 1, 1)
        eng.pop()
    }
    val inside = func () {
        val mx, my = eng.mouse()
        (mx >= x - w/2) && (mx <= x + w/2) && (my >= y - h/2) && (my <= y + h/2)
    }

    loop {
        ;; out
        if !inside() {
            par :any {
                await :mouse.mv until inside()
            } with {
                loop on :draw {
                    draw(bg_color@0, t_out)
                }
            }
        }
        ;; over
        play(ui_hover1, [pitch=rfloat(1.3, 1.5), volume=0.5])
        play(pop2, [pitch=rfloat(0.95, 1.05), volume=0.5])
        spring_pull(s, 0.2, 200, 10)
        par :any {
            await :mouse.mv until !inside()
        } with {
            loop on :mouse.dn until it.but == 1 {
                emit @owner :Button.click [ id=id, spring=s ]
            }
        } with {
            ;; its text under the mouse, if any (`mouse_enter` of the
            ;; buttons "R" and "?" of the shop)
            if opts && opts.info {
                await InfoText(x, y + 20, opts.info, true)
            } else {
                await(false)
            }
        } with {
            loop on :draw {
                draw(fg@0, t_over)
            }
        }
    }
}
