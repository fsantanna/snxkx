;; The things that the units summon and that fight by themselves, as the
;; classes of `player.lua`: the pets of the hunter (`Pet`), the critters
;; (`Critter`), and the automatons of the artificer (`Automaton`).

;; As `Pet`: a square that runs along `r`, crosses six enemies, pushing
;; and hitting each, and dies on a wall (at level 3 of its hunter, it
;; bounces once).
task Pet (A, x, y, r, v, parent, fx) {
    trace("add", string.format("Pet %.1f %.1f", x, y))
    val o = [ kind=:pet, w=8, h=8, x=x, y=y, r=r, v=v, pierce=6, ricochet=1, hit=hfx(1),
              color=character_colors@("hunter") ]
    body(A.w, o, :dynamic, x, y, :projectile, [:rect, 8, 8])
    defer {
        body_free(A.w, o.b)
    }
    body_restitution(o.b, 0.5)
    play(pet1, [pitch=rfloat(0.95, 1.05), volume=0.35])
    spawn Springs(o.hit.s)
    pin fxs = tasks()
    spawn {
        loop on :draw {
            eng.push(o.x, o.y, o.r, o.hit.s.x)
            eng.rect(o.x, o.y, 8, 8, 3, 3, if o.hit.f > 0 => fg@0 => o.color)
            eng.pop()
        }
    }
    par :any {
        loop on :clock {
            set o.x, o.y = body_pos(o.b)
            body_set(o.b, :angle, o.r)
            body_set(o.b, :velocity, o.v*math.cos(o.r), o.v*math.sin(o.r))
        }
    } with {
        loop c on :collision.enter until (it.b == o.b) && (it.other.kind == :wall) {
            loop _ in rint(3, 4) {
                spawn @fx HitParticle(c.x, c.y, [r=rfloat(0, 2*math.pi), color=o.color])
            }
            spawn @fx HitCircle(c.x, c.y, [scale_down=true])
            play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
            until (parent.level != 3) || (o.ricochet <= 0)
            bounce(o, c.nx, c.ny)
            set o.ricochet -= 1
        }
    } with {
        loop c on :trigger.enter until (it.b == o.b) && (it.other.kind == :enemy) {
            val e = c.other
            shake(2, 0.5)
            hit(e, parent.dmg*(parent.conjurer_buff_m || 1))
            push(e, 35*(parent.knockback_m || 1), angle_to(o, e.x, e.y))
            play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
            until o.pierce <= 0
            set o.pierce -= 1
        }
        loop _ in rint(3, 4) {
            spawn @fx HitParticle(o.x, o.y, [r=rfloat(0, 2*math.pi), color=o.color])
        }
        spawn @fx HitCircle(o.x, o.y, [scale_down=true])
    }
}

;; As `Critter`: a small orange unit, thrown out at `v` along `r`, that
;; chases a random enemy and bites it, losing one of its few hits (more
;; with the swarmers). No more than 100 at once.
task Critter (A, x, y, r, v, dmg, parent, fx) {
    if #A.critters > 100 {
        return nil
    }
    trace("add", string.format("Critter %.1f %.1f", x, y))
    val c = [ kind=:critter, w=7, h=4, x=x, y=y, r=r, level=nil, stats=:critter,
              classes=[:enemy_critter], color=orange@0, hit=hfx(1) ]
    unit_stats(c, true, 0)
    set c.dmg = dmg || parent.dmg
    set c.hp = 1 + (match A.cl.swarmer { 2 => 3 ; 1 => 1 ; else => 0 }) + (parent.hive || 0)
    body(A.w, c, :dynamic, x, y, :player, [:rect, 7, 4])
    body_restitution(c.b, 0.5)
    val st = steerable(c.b, c.v, 400, math.pi, 1)
    set A.critters@+ = c
    defer {
        body_free(A.w, c.b)
        val cs = []
        loop _, o in A.critters {
            if o != c {
                set cs@+ = o
            }
        }
        set A.critters = cs
    }
    spawn Springs(c.hit.s)
    pin fxs = tasks()
    spawn {
        loop on :draw {
            eng.push(c.x, c.y, c.r, c.hit.s.x)
            eng.rect(c.x, c.y, 7, 4, 2, 2, if c.hit.f > 0 => fg@0 => c.color)
            eng.pop()
        }
    }
    var invulnerable = true
    spawn {
        await 500ms
        set invulnerable = false
    }
    spawn {
        loop w on :collision.enter until (it.b == c.b) && (it.other.kind == :wall) {
            spawn @fxs HfxUse(c.hit, 0.15, 200, 10, 0.1)
            bounce(c, w.nx, w.ny)
        }
    }
    par :any {
        ;; its hits: one per bite (the original's `Critter:hit`)
        loop h on :Hit until it.to == c {
            if !invulnerable {
                spawn @fxs HfxUse(c.hit, 0.25, 200, 10)
                set c.hp -= 1
                if passive_level(A, "baneling_burst") {
                    set c.hp = 0            ;; it bursts at once
                }
            }
            until c.hp <= 0
        }
    } with {
        loop t on :trigger.enter until (it.b == c.b) && (it.other.kind == :enemy) {
            play(critter2, [pitch=rfloat(0.65, 0.85), volume=0.1])
            hit(c, 1)
            hit(t.other, c.dmg, [critter=c])
        }
    } with {
        ;; thrown out (as `Critter:push`), then chasing
        var p = [ f=v, r=r ]
        var target = nil
        loop {
            loop {
                body_set(c.b, :impulse, p.f*math.cos(p.r), p.f*math.sin(p.r))
                body_set(c.b, :angular_impulse,
                    rtable([rfloat(-12*math.pi, -4*math.pi), rfloat(4*math.pi, 12*math.pi)]))
                body_set(c.b, :damping, 1.5)
                body_set(c.b, :angular_damping, 1.5)
                set p = par :any {
                    loop on :clock {
                        set c.x, c.y = body_pos(c.b)
                        set c.r = body_angle(c.b)
                        val vx, vy = body_vel(c.b)
                        until math.sqrt(vx*vx + vy*vy) < 50
                    }
                    nil
                } with {
                    await :Push until it.to == c
                }
                until !p
            }
            body_set(c.b, :damping, 0)
            body_set(c.b, :angular_damping, 0)
            set p = par :any {
                loop on :clock {
                    set c.x, c.y = body_pos(c.b)
                    set c.r = body_angle(c.b)
                    if !target || X.nin(target, A.enemies) {
                        set target = if #A.enemies > 0 => rtable(A.enemies) => nil
                    }
                    steer_update(st)
                    if target {
                        seek_point(st, target.x, target.y)
                    } else {
                        seek_point(st, W/2, H/2)
                    }
                    wander(st, 50, 200, 50)
                    rotate_towards_velocity(c.b, 1)
                    separate(st, 8, A.critters)
                }
            } with {
                await :Push until it.to == c
            }
        }
    }
    ;; as `Critter:die`
    loop _ in rint(2, 3) {
        spawn @fx HitParticle(c.x, c.y, [r=rfloat(0, 2*math.pi), color=c.color])
    }
    spawn @fx HitCircle(c.x, c.y, [scale_down=true])
    play(rtable([enemy_die1, enemy_die2]), [pitch=rfloat(0.9, 1.1), volume=0.5])
    play(critter2, [pitch=rfloat(0.95, 1.05), volume=0.2])
    val bb = passive_level(A, "baneling_burst")
    if bb {
        shake(2, 0.5)
        spawn @fx Area(A, [x=c.x, y=c.y, r=c.r, w=parent.area_size_m*24, color=c.color,
                           dmg=lv(bb, 50, 100, 150, 0), parent=parent], fx)
        play(rtable([cannoneer1, cannoneer2]), [pitch=rfloat(0.95, 1.05), volume=0.5])
    }
}

;; As `Automaton`: a slow unit of the artificer that chases a random
;; enemy, shoots the closest one every 2s (1.5s at level 3), and breaks
;; down after 18s (more with the conjurers), throwing 12 projectiles at
;; level 3.
task Automaton (A, x, y, parent, fx, shots) {
    trace("add", string.format("Automaton %.1f %.1f", x, y))
    val a = [ kind=:automaton, w=8, h=8, x=x, y=y, r=0, level=parent.level, stats=:automaton,
              classes=[:sorcerer, :conjurer], color=character_colors@("artificer"), hit=hfx(1), alive=true ]
    unit_stats(a, true, 0)
    defer {
        set a.alive = false
    }
    body(A.w, a, :dynamic, x, y, :player, [:rect, 8, 8])
    body_restitution(a.b, 0.5)
    val st = steerable(a.b, a.v, 2000, 4*math.pi, 4)
    defer {
        body_free(A.w, a.b)
    }
    spawn Springs(a.hit.s)
    spawn {
        loop on :draw {
            eng.push(a.x, a.y, a.r, a.hit.s.x)
            eng.rect(a.x, a.y, 8, 8, 3, 3, if a.hit.f > 0 => fg@0 => a.color)
            eng.pop()
        }
    }
    var target = nil
    par :any {
        await((18*(parent.conjurer_buff_m || 1)) * 1s)
    } with {
        loop on :clock {
            set a.x, a.y = body_pos(a.b)
            unit_stats(a, false, 0)
            set st.max_v = a.max_v
            if !target || X.nin(target, A.enemies) {
                set target = if #A.enemies > 0 => rtable(A.enemies) => nil
            }
            steer_update(st)
            if target {
                seek_point(st, target.x, target.y)
            } else {
                seek_point(st, W/2, H/2)
            }
            wander(st, 50, 200, 50)
            rotate_towards_velocity(a.b, 1)
            separate(st, 32, A.enemies)
            set a.r = body_angle(a.b)
        }
    } with {
        ;; its cooldown is 2s, times 0.75 at level 3 (`set_every_multiplier`)
        val u = [ aspd_m=(if parent.level == 3 => 0.75 => 1) ]
        loop {
            await Cooldown(u, 2, \{ #enemies_in_circle(A, a.x, a.y, 96) > 0 })
            val e = closest_enemy(A, a.x, a.y, 96)
            if e {
                play(turret1, [pitch=rfloat(0.95, 1.05), volume=0.1])
                play(turret2, [pitch=rfloat(0.95, 1.05), volume=0.1])
                play(wizard1, [pitch=rfloat(0.95, 1.05), volume=0.1])
                val r = angle_to(a, e.x, e.y)
                spawn @fx HitCircle(a.x + 0.8*8*math.cos(r), a.y + 0.8*8*math.sin(r), [rs=6])
                spawn @shots Projectile(A, [x=a.x + 1.6*8*math.cos(r), y=a.y + 1.6*8*math.sin(r), v=250, r=r,
                    color=parent.color, dmg=parent.dmg, character="artificer", parent=parent, level=parent.level], fx)
            }
            if parent.rearm {
                spawn @fx AutomatonShot(A, a, parent, 0.25, fx, shots)
            }
            taunt(A, a, parent, fx)
        }
    }
    loop _ in rint(3, 4) {
        spawn @fx HitParticle(a.x, a.y, [r=rfloat(0, 2*math.pi), color=a.color])
    }
    spawn @fx HitCircle(a.x, a.y, [scale_down=true])
    if parent.level == 3 {
        play(shoot1, [pitch=rfloat(0.95, 1.05), volume=0.2])
        loop i in 12 {
            spawn @shots Projectile(A, [x=a.x, y=a.y, color=a.color, r=i*math.pi/6, v=200, dmg=parent.dmg,
                character="artificer_death", parent=parent, level=parent.level, pierce=1, ricochet=1], fx)
        }
    }
}

;; The damage of a character of a level with no buffs, as
;; `get_character_stat(character, level, 'dmg')` (a new unit, rounded).
func character_dmg (character, level) {
    val u = [ character=character, level=level, stats=:player, classes=character_classes@(character) ]
    unit_stats(u, true, 0)
    math.floor(u.dmg*100 + 0.5) / 100
}

;; What remains of a construct when it ends: with `construct_instability`,
;; it explodes (a passive).
task Unstable (A, o, parent, k, fx) {
    if parent.construct_instability {
        shake(2, 0.5)
        val n = match parent.construct_instability { 1 => 1 ; 2 => 1.5 ; 3 => 2 ; else => 1 }
        spawn @fx Area(A, [x=o.x, y=o.y, r=o.r || 0, w=parent.area_size_m*48*(k || 1), color=o.color,
                           dmg=n*parent.dmg*parent.area_dmg_m*(k || 1), parent=parent], fx)
        play(rtable([cannoneer1, cannoneer2]), [pitch=rfloat(0.95, 1.05), volume=0.5])
    }
}

;; As `Saboteur`: a unit that runs to a random enemy and explodes on the
;; first one it touches (a larger area, twice the damage, on a crit).
task Saboteur (A, x, y, parent, crit, fx) {
    trace("add", string.format("Saboteur %.1f %.1f", x, y))
    val o = [ kind=:saboteur, w=8, h=8, x=x, y=y, r=0, level=parent.level, stats=:player,
              character="saboteur", classes=character_classes@("saboteur"),
              color=character_colors@("saboteur"), hit=hfx(1) ]
    unit_stats(o, true, 0)
    body(A.w, o, :dynamic, x, y, :player, [:rect, 8, 8])
    body_restitution(o.b, 0.5)
    val st = steerable(o.b, o.v, 2000, 4*math.pi, 4)
    defer {
        body_free(A.w, o.b)
    }
    play(rtable([saboteur1, saboteur2, saboteur3]), [pitch=rfloat(0.8, 1.2), volume=0.2])
    val dmg = 2*character_dmg("saboteur", parent.level)
    spawn Springs(o.hit.s)
    spawn {
        loop on :draw {
            eng.push(o.x, o.y, o.r, o.hit.s.x)
            eng.rect(o.x, o.y, 8, 8, 3, 3, if o.hit.f > 0 => fg@0 => o.color)
            eng.pop()
        }
    }
    var target = if #A.enemies > 0 => rtable(A.enemies) => nil
    par :any {
        loop on :clock {
            set o.x, o.y = body_pos(o.b)
            set o.buff_area_size_m = parent.buff_area_size_m
            set o.buff_area_dmg_m = parent.buff_area_dmg_m
            unit_stats(o, false, 0)
            if !target || X.nin(target, A.enemies) {
                set target = if #A.enemies > 0 => rtable(A.enemies) => nil
            }
            steer_update(st)
            if target {
                seek_point(st, target.x, target.y)
            } else {
                seek_point(st, W/2, H/2)
            }
            rotate_towards_velocity(o.b, 0.5)
            set o.r = body_angle(o.b)
        }
    } with {
        await :collision.enter until (it.b == o.b) && (it.other.kind == :enemy)
    }
    shake(4, 0.5)
    spawn @fx Area(A, [x=o.x, y=o.y, r=o.r, w=(if crit => 1.5 => 1)*o.area_size_m*64, color=o.color,
        dmg=(if crit => 2 => 1)*o.area_dmg_m*dmg*(parent.conjurer_buff_m || 1), character="saboteur", parent=parent], fx)
    if parent.construct_instability {
        await 250ms
        await Unstable(A, o, parent, 1, fx)
    }
}

;; As `Bomb`: a mine that explodes after 8s or when an enemy touches it.
task Bomb (A, x, y, parent, fx) {
    trace("add", string.format("Bomb %.1f %.1f", x, y))
    val o = [ kind=:bomb, w=8, h=8, x=x, y=y, r=0, color=orange@0, hit=hfx(1) ]
    body(A.w, o, :static, x, y, :player, [:rect, 8, 8])
    defer {
        body_free(A.w, o.b)
    }
    play(mine1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    val k = if parent.level == 3 => 2 => 1
    val dmg = 2*character_dmg("bomber", parent.level)
    spawn Springs(o.hit.s)
    spawn {
        loop on :draw {
            eng.push(o.x, o.y, o.r, o.hit.s.x)
            eng.rect(o.x, o.y, 8, 8, 3, 3, if o.hit.f > 0 => fg@0 => o.color)
            eng.pop()
        }
    }
    par :any {
        await 8s
    } with {
        await :collision.enter until (it.b == o.b) && (it.other.kind == :enemy)
    }
    shake(4, 0.5)
    spawn @fx Area(A, [x=o.x, y=o.y, r=o.r, w=parent.area_size_m*64*k, color=o.color,
        dmg=parent.area_dmg_m*dmg*(parent.conjurer_buff_m || 1)*k, parent=parent], fx)
    play(rtable([cannoneer1, cannoneer2]), [pitch=rfloat(0.95, 1.05), volume=0.5])
    play(rtable([saboteur_hit1, saboteur_hit2]), [pitch=rfloat(0.95, 1.05), volume=0.5])
    play(explosion1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    if parent.construct_instability || parent.rearm {
        await 250ms
        await Unstable(A, o, parent, k, fx)
    }
}

;; As `Turret`: a static gun of the engineer that turns to the closest
;; enemy and fires three shots every 2.75 to 3.5s, for 24s. An upgrade
;; (the engineer of level 3) makes it hit harder and faster.
task Turret (A, x, y, parent, fx, shots) {
    trace("add", string.format("Turret %.1f %.1f", x, y))
    val o = [ kind=:turret, w=14, h=6, x=x, y=y, r=0, color=orange@0, hit=hfx(1), upgrade_dmg_m=1, upgrade_aspd_m=1, alive=true ]
    body(A.w, o, :static, x, y, :player, [:rect, 14, 6])
    defer {
        body_free(A.w, o.b)
    }
    set A.turrets@+ = o
    defer {
        val ts = []
        loop _, t in A.turrets {
            if t != o {
                set ts@+ = t
            }
        }
        set A.turrets = ts
    }
    play(turret_deploy, [pitch=1.2, volume=0.2])
    spawn Springs(o.hit.s)
    pin fxs = tasks()
    spawn {
        loop on :draw {
            eng.push(o.x, o.y, o.r, o.hit.s.x)
            eng.rect(o.x, o.y, 14, 6, 3, 3, if o.hit.f > 0 => fg@0 => o.color)
            eng.pop()
        }
    }
    spawn {
        loop on :Upgrade until it.to == o {
            set o.upgrade_dmg_m += 0.5
            set o.upgrade_aspd_m += 0.5
            loop _ in 6 {
                spawn @fx HitParticle(o.x, o.y, [r=rfloat(0, 2*math.pi), color=o.color])
            }
            spawn @fx HitCircle(o.x, o.y, [scale_down=true])
        }
    }
    par :any {
        await((24*(parent.conjurer_buff_m || 1)) * 1s)
    } with {
        loop on :clock {
            val e = closest_enemy(A, o.x, o.y, 256)
            if e {
                rotate_towards_point(o.b, e.x, e.y, 0.2)
                set o.r = body_angle(o.b)
            }
        }
    } with {
        val tk = [ t=0 ]
        loop {
            ;; its period shrinks with the upgrades (`set_every_multiplier`)
            await Every([ aspd_m=1/o.upgrade_aspd_m ], rfloat(2.75, 3.5), tk)
            taunt(A, o, parent, fx)
            if parent.rearm {
                spawn @fxs TurretRearm(A, o, parent, fx, shots)
            }
            loop i in 3 {
                await((rfloat(0.1, 0.2)) * 1s)
                spawn @fxs HfxUse(o.hit, 0.25, 200, 10)
                spawn @fx HitCircle(o.x + 0.8*14*math.cos(o.r), o.y + 0.8*14*math.sin(o.r), [rs=6])
                spawn @shots Projectile(A, [x=o.x + 1.6*14*math.cos(o.r), y=o.y + 1.6*14*math.sin(o.r), v=200, r=o.r,
                    color=o.color, dmg=parent.dmg*(parent.conjurer_buff_m || 1)*o.upgrade_dmg_m,
                    character=parent.character, parent=parent], fx)
                play(turret1, [pitch=rfloat(0.95, 1.05), volume=0.35])
                play(turret2, [pitch=rfloat(0.95, 1.05), volume=0.35])
            }
        }
    }
    set o.alive = false
    loop _ in rint(3, 4) {
        spawn @fx HitParticle(o.x, o.y, [r=rfloat(0, 2*math.pi), color=o.color])
    }
    spawn @fx HitCircle(o.x, o.y, [scale_down=true])
    spawn @fx Unstable(A, o, parent, 1, fx)
}

;; As `Tree`: a static cross of the carver that grows a healing orb every
;; 6s (3s at level 3), for 12s.
task Tree (A, x, y, parent, fx) {
    trace("add", string.format("Tree %.1f %.1f", x, y))
    val o = [ kind=:tree, w=9, h=9, x=x, y=y, r=0, color=fg@0, hit=hfx(1), alive=true ]
    body(A.w, o, :static, x, y, :player, [:rect, 9, 9])
    defer {
        body_free(A.w, o.b)
    }
    play(buff1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    val faint = alpha(parent.color, 0.08)
    val s = spring(1)
    spawn Springs(s, o.hit.s)
    pin fxs = tasks()
    spawn {
        await 200ms
        set o.color = parent.color
    }
    val dvr = rfloat(-math.pi/4, math.pi/4)
    var vr = 0
    var shown = true
    spawn {
        loop us on :clock {
            set vr += dvr*(us / 1000000)
        }
    }
    spawn {
        loop on :draw {
            if shown {
                eng.push(o.x, o.y, math.pi/4, s.x)
                eng.rect(o.x, o.y, 1.5*9, 4, 2, 2, if o.hit.f > 0 => fg@0 => o.color)
                eng.rect(o.x, o.y, 4, 1.5*9, 2, 2, if o.hit.f > 0 => fg@0 => o.color)
                eng.pop()
                round_area(o.x, o.y, 48, vr, s.x, o.color, faint)
            }
        }
    }
    par :any {
        await((12*(parent.conjurer_buff_m || 1)) * 1s)
    } with {
        loop {
            await((if parent.level == 3 => 3 => 6) * 1s)
            spawn @fxs HfxUse(o.hit, 0.2)
            spawn @fx HealingOrb(A, o.x, o.y, fx)
            taunt(A, o, parent, fx)
            if parent.rearm {
                spawn @fxs TreeRearm(A, o, parent, fx)
            }
        }
    }
    set o.alive = false
    loop i in 7 {
        if i > 0 {
            await 50ms
        }
        set shown = !shown
    }
    spawn @fx Unstable(A, o, parent, 1, fx)
}

;; As `Volcano`: a static cone of the vulcanist that erupts every 1s
;; (0.5s at level 3), 4 times (8), an area each time, for 4s.
task Volcano (A, x, y, parent, fx) {
    trace("add", string.format("Volcano %.1f %.1f", x, y))
    val o = [ kind=:volcano, w=9, h=9, x=x, y=y, r=0, color=fg@0, hit=hfx(1) ]
    body(A.w, o, :static, x, y, :player, [:rect, 9, 9])
    body_restitution(o.b, 0.5)
    defer {
        body_free(A.w, o.b)
    }
    val faint = alpha(parent.color, 0.08)
    val s = spring(1)
    spawn Springs(s, o.hit.s)
    spawn {
        await 200ms
        set o.color = parent.color
    }
    val dvr = rfloat(-math.pi/4, math.pi/4)
    var vr = 0
    var shown = true
    spawn {
        loop us on :clock {
            set vr += dvr*(us / 1000000)
        }
    }
    spawn {
        loop on :draw {
            if shown {
                eng.push(o.x, o.y, -math.pi/2, s.x)
                eng.triangle_equilateral(o.x, o.y, 1.5*9, if o.hit.f > 0 => fg@0 => o.color, 3)
                eng.pop()
                round_area(o.x, o.y, 24, vr, s.x, o.color, faint)
            }
        }
    }
    shake(6, 1)
    play(earth1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    play(fire1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    spawn {
        loop _ in (if parent.level == 3 => 8 => 4) {
            await((if parent.level == 3 => 0.5 => 1) * 1s)
            shake(4, 0.5)
            play(rtable([earth1, earth2, earth3]), [pitch=rfloat(0.95, 1.05), volume=0.25])
            play(rtable([fire1, fire2, fire3]), [pitch=rfloat(0.95, 1.05), volume=0.25])
            spawn @fx Area(A, [x=o.x, y=o.y, w=parent.area_size_m*72, r=rfloat(0, 2*math.pi), color=o.color,
                dmg=(parent.area_dmg_m || 1)*parent.dmg, character=parent.character, level=parent.level, parent=parent], fx)
        }
    }
    await 4s
    loop i in 7 {
        if i > 0 {
            await 50ms
        }
        set shown = !shown
    }
}

;; As `ForceField`: a yellow circle of the warden around a unit for 6s,
;; that pushes the enemies that touch it.
task ForceField (A, u, fx) {
    trace("add", string.format("ForceField %.1f %.1f", u.x, u.y))
    val rs = match u.magnify { 1 => 14 ; 2 => 17 ; 3 => 20 ; else => 12 }
    val o = [ kind=:force_field, x=u.x, y=u.y, r=0, color=fg@0, hit=hfx(1) ]
    body(A.w, o, :static, u.x, u.y, :force_field, [:circle, rs])
    defer {
        body_free(A.w, o.b)
    }
    val faint = alpha(yellow@0, 0.08)
    val s = spring(1)
    spawn Springs(s, o.hit.s)
    pin fxs = tasks()
    spawn {
        await 200ms
        set o.color = yellow@0
    }
    var shown = true
    spawn {
        loop on :draw {
            if shown {
                eng.push(o.x, o.y, 0, s.x*o.hit.s.x)
                eng.circle(o.x, o.y, rs, if o.hit.f > 0 => fg@0 => o.color, 2)
                eng.circle(o.x, o.y, rs, if o.hit.f > 0 => alpha(fg@0, 0.08) => faint)
                eng.pop()
            }
        }
    }
    par :any {
        loop on :clock {
            until X.nin(u, A.units)
            set o.x = u.x
            set o.y = u.y
            body_set(o.b, :position, u.x, u.y)
        }
    } with {
        loop c on :collision.enter until (it.b == o.b) && (it.other.kind == :enemy) {
            val e = c.other
            push(e, rfloat(15, 20)*(u.knockback_m || 1), angle_to(u, e.x, e.y))
            hit(e, 0)
            spawn @fx HitCircle(c.x, c.y, [rs=6, color=fg@0, duration=0.1])
            loop _ in 2 {
                spawn @fx HitParticle(c.x, c.y, [color=o.color])
            }
            loop _ in 2 {
                spawn @fx HitParticle(c.x, c.y, [color=e.color])
            }
            spawn @fxs HfxUse(o.hit, 0.2)
            play(dot1, [pitch=rfloat(0.95, 1.05), volume=0.3])
        }
    } with {
        await 6s
        play(dot1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        loop i in 7 {
            if i > 0 {
                await 50ms
            }
            set shown = !shown
        }
    }
}

;; As `Gold`: a coin that drops, moves to the units near it, and is
;; picked up by one (gold for the end of the level). With a miner, the
;; coin bursts into projectiles (4, or 8 at level 3).
task Gold (A, x, y, fx, shots) {
    if A.golds > 30 {
        return nil
    }
    set A.golds += 1
    trace("add", string.format("Gold %.1f %.1f", x, y))
    val o = [ kind=:gold, w=3, h=3, x=x, y=y, r=0, hit=hfx(1), color=yellow2@0 ]
    body(A.w, o, :dynamic, x, y, :ghost, [:rect, 3, 3])
    defer {
        body_free(A.w, o.b)
        set A.golds -= 1
    }
    body_restitution(o.b, 0.5)
    val r = rfloat(0, 2*math.pi)
    val f = rfloat(2, 4)
    body_set(o.b, :impulse, f*math.cos(r), f*math.sin(r))
    body_set(o.b, :angular_impulse, rtable([rfloat(-6*math.pi, -2*math.pi), rfloat(2*math.pi, 6*math.pi)]))
    body_set(o.b, :damping, 2.5)
    body_set(o.b, :angular_damping, 5)
    play(gold1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    spawn Springs(o.hit.s)
    spawn {
        loop on :draw {
            eng.push(o.x, o.y, o.r, o.hit.s.x)
            eng.rect(o.x, o.y, 3, 3, 1, 1, if o.hit.f > 0 => fg@0 => o.color)
            eng.pop()
        }
    }
    spawn {
        loop on :clock {
            magnet(A, o)
        }
    }
    await 500ms
    await :trigger.enter until (it.b == o.b) && (it.other.kind == :player)
    set A.gold_picked_up += 1
    trace("gold", tostring(A.gold_picked_up))
    spawn @fx HitCircle(o.x, o.y, [rs=4, color=fg@0, duration=0.1])
    loop _ in 2 {
        spawn @fx HitParticle(o.x, o.y, [color=o.color])
    }
    play(rtable([gold2, coins1, coins2, coins3]), [pitch=rfloat(0.9, 1.1), volume=0.3])
    var th = nil
    loop _, u in A.units {
        if u.character == "miner" {
            set th = u
        }
    }
    if th {
        play(rtable([scout1, scout2]), [pitch=rfloat(0.95, 1.05), volume=0.35])
        spawn @fx HitCircle(o.x, o.y, [rs=6])
        var a = rfloat(0, 2*math.pi)
        val n = if th.level == 3 => 8 => 4
        loop _ in n {
            spawn @shots Projectile(A, [x=o.x + 8*math.cos(a), y=o.y + 8*math.sin(a), v=250, r=a, color=yellow2@0,
                dmg=th.dmg, character=th.character, parent=th, level=th.level], fx)
            set a += 2*math.pi/n
        }
    }
}

;; Taunt: a construct may draw the enemies around it for 4s.
func taunt (A, o, parent, fx) {
    if parent.taunt && rbool(lv(parent.taunt, 10, 20, 30)) {
        loop _, e in enemies_in_circle(A, o.x, o.y, 96) {
            emit @:global :Taunt [ to=e, by=o ]
        }
    }
}

;; Rearm: the constructs act again (an automaton shoots after 0.25s, a
;; turret fires a burst after 1s, a tree grows an orb after 0.25s).
task AutomatonShot (A, a, parent, d, fx, shots) {
    await(d * 1s)
    val e = closest_enemy(A, a.x, a.y, 96)
    if e && a.alive {
        play(turret1, [pitch=rfloat(0.95, 1.05), volume=0.1])
        play(turret2, [pitch=rfloat(0.95, 1.05), volume=0.1])
        play(wizard1, [pitch=rfloat(0.95, 1.05), volume=0.1])
        val r = angle_to(a, e.x, e.y)
        spawn @fx HitCircle(a.x + 0.8*8*math.cos(r), a.y + 0.8*8*math.sin(r), [rs=6])
        spawn @shots Projectile(A, [x=a.x + 1.6*8*math.cos(r), y=a.y + 1.6*8*math.sin(r), v=250, r=r,
            color=parent.color, dmg=parent.dmg, character="artificer", parent=parent, level=parent.level], fx)
    }
}

task TurretRearm (A, o, parent, fx, shots) {
    await 1s
    pin fxs = tasks()
    loop _ in 3 {
        await((rfloat(0.1, 0.2)) * 1s)
        spawn @fxs HfxUse(o.hit, 0.25, 200, 10)
        spawn @fx HitCircle(o.x + 0.8*14*math.cos(o.r), o.y + 0.8*14*math.sin(o.r), [rs=6])
        spawn @shots Projectile(A, [x=o.x + 1.6*14*math.cos(o.r), y=o.y + 1.6*14*math.sin(o.r), v=200, r=o.r,
            color=o.color, dmg=parent.dmg*(parent.conjurer_buff_m || 1)*o.upgrade_dmg_m,
            character=parent.character, parent=parent], fx)
        play(turret1, [pitch=rfloat(0.95, 1.05), volume=0.35])
        play(turret2, [pitch=rfloat(0.95, 1.05), volume=0.35])
    }
    taunt(A, o, parent, fx)
}

task TreeRearm (A, o, parent, fx) {
    await 250ms
    spawn @fx HealingOrb(A, o.x, o.y, fx)
    taunt(A, o, parent, fx)
}
