;; The attacks of the units, as `Player:shoot`, `Player:attack`,
;; `Projectile`, and `Area` of the original (`player.lua`), for the
;; characters ported so far.

;;; SHAPES ;;;

;; The corners of a rectangle centered at (x,y), turned by r.
func rect_corners (x, y, w, h, r) {
    val c = math.cos(r || 0)
    val s = math.sin(r || 0)
    val out = []
    loop _, p in [[-w/2, -h/2], [w/2, -h/2], [w/2, h/2], [-w/2, h/2]] {
        set out@+ = [ x + c*p@0 - s*p@1, y + s*p@0 + c*p@1 ]
    }
    out
}

;; Whether two convex polygons (vectors of [x,y]) overlap: no separating
;; axis among the normals of their edges.
func polys_overlap (a, b) {
    var sep = false
    loop _, poly in [a, b] {
        val n = #poly
        loop i in n {
            val p = poly@(i)
            val q = poly@((i + 1) % n)
            val ax = q@1 - p@1
            val ay = p@0 - q@0
            var amin, amax = math.huge, -math.huge
            loop _, v in a {
                val d = v@0*ax + v@1*ay
                set amin = math.min(amin, d)
                set amax = math.max(amax, d)
            }
            var bmin, bmax = math.huge, -math.huge
            loop _, v in b {
                val d = v@0*ax + v@1*ay
                set bmin = math.min(bmin, d)
                set bmax = math.max(bmax, d)
            }
            if (amax < bmin) || (bmax < amin) {
                set sep = true
            }
        }
    }
    !sep
}

;; Whether a circle touches the rectangle of a record (x, y, w, h, r).
func circle_hits (cx, cy, rs, o) {
    val dx = cx - o.x
    val dy = cy - o.y
    val c = math.cos(-(o.r || 0))
    val s = math.sin(-(o.r || 0))
    val lx = c*dx - s*dy
    val ly = s*dx + c*dy
    val px = math.max(-o.w/2, math.min(o.w/2, lx))
    val py = math.max(-o.h/2, math.min(o.h/2, ly))
    ((lx - px)*(lx - px) + (ly - py)*(ly - py)) <= rs*rs
}

;; The enemies in a circle, as `get_objects_in_shape(Circle(...), enemies)`.
func enemies_in_circle (A, x, y, rs) {
    val out = []
    loop _, e in A.enemies {
        if circle_hits(x, y, rs, e) {
            set out@+ = e
        }
    }
    out
}

;; The closest of the enemies in a circle, or nil.
func closest_enemy (A, x, y, rs, exclude) {
    var best = nil
    var bd = 1000000
    loop _, e in enemies_in_circle(A, x, y, rs) {
        if !exclude || X.nin(e, exclude) {
            val d = math.sqrt((e.x - x)*(e.x - x) + (e.y - y)*(e.y - y))
            if d < bd {
                set bd = d
                set best = e
            }
        }
    }
    best
}

;; A random one of the enemies in a circle, avoiding `exclude` (as the
;; original: up to 20 tries), or nil.
func random_enemy (A, x, y, rs, exclude) {
    val es = enemies_in_circle(A, x, y, rs)
    if #es == 0 {
        return nil
    }
    var e = rtable(es)
    var tries = 0
    loop {
        while exclude && X.xin(e, exclude) && (tries < 20)
        set e = rtable(es)
        set tries += 1
    }
    e
}

;;; COOLDOWNS ;;;

;; As `t:cooldown(d, condition, action)` of the original, up to the
;; action: `d` seconds (times the attack speed of the unit, read in every
;; tick), and then until there is a target. The bar of the unit shows
;; the time (`u.cooldown`, from 0 to 1).
task Cooldown (u, d, ready) {
    var timer = 0
    loop us on :clock {
        set timer += us / 1000000
        set u.cooldown = math.min(timer / (d*u.aspd_m), 1)
        until (timer > d*u.aspd_m) && ready()
    }
    set u.cooldown = 0
}

;; As `t:every(d, action, nil, nil, tag)` with the tag 'shoot' or
;; 'attack', whose delay the attack speed multiplies in every tick
;; (`set_every_multiplier`): `d` seconds times `u.aspd_m`. The timer `tk`
;; keeps what passes beyond the delay, as `every` does.
task Every (u, d, tk) {
    loop us on :clock {
        set tk.t += us / 1000000
        until tk.t > d*u.aspd_m
    }
    set tk.t -= d*u.aspd_m
}

;; Whether an attack of a sorcerer is repeated: every 4, 3, or 2 attacks
;; with the sorcerers of level 1, 2, or 3 (`sorcerer_count`).
func sorcerer_due (A, u) {
    val l = A.cl && A.cl.sorcerer || 0
    if l > 0 {
        set u.sorcerer_count = (u.sorcerer_count || 0) + 1
        if u.sorcerer_count >= (match l { 3 => 2 ; 2 => 3 ; else => 4 }) {
            set u.sorcerer_count = 0
            return true
        }
    }
    false
}

;;; PROJECTILES ;;;

;; As `Projectile`: a rectangle 10x4 that flies at `v` along `r`, hits
;; the enemies it crosses, and dies on a wall. Options: `pierce` (how many
;; enemies it crosses), `chain` (how many times it turns to a new enemy),
;; `ricochet` (how many times it bounces on a wall), `homing` (it turns to
;; the closest enemy, after 0.1s). Some characters fly otherwise
;; (`Projectile:init` and `update`, `player.lua:1975-2140`): the orb of
;; the sage pulls the enemies and bursts, the knife of the spellblade
;; spins around its path, the orbs of the psykers circle their units, the
;; ball of the arcanist shoots smaller ones.
task Projectile (A, p, fx) {
    set p.kind = :projectile
    set p.w = 10
    set p.h = 4
    set p.pierce = p.pierce || 0
    set p.chain = p.chain || 0
    set p.ricochet = p.ricochet || 0
    set p.hit = hfx(1)
    val c = p.character
    val hit_list = []
    body(A.w, p, :dynamic, p.x, p.y, :projectile, [:rect, 10, 4])
    defer {
        body_free(A.w, p.b)
    }
    pin ps = tasks()            ;; what the projectile does beside flying
    spawn Springs(p.hit.s)
    var shown = true
    var orbit_r = 0
    var vr = 0
    val st = [ rs=0, pull=0, orbit_vr=0 ]
    ifs {
        c == "sage" => {
            set p.compression_dmg = p.dmg
            set p.dmg = 0
            set st.pull = 64*p.parent.area_size_m
            play(elementor1, [pitch=rfloat(0.9, 1.1), volume=0.5])
            spawn @ps SageGrow(p, st)
            spawn @ps Trail(p, fx, false)
        }
        c == "spellblade" => {
            set p.pierce = 1000
            if p.level == 3 {
                set p.v = 1.5*p.v
            }
            set st.orbit_vr = if p.level == 3 => 12*math.pi => 8*math.pi
            spawn @ps SpellOrbit(p, st)
        }
        c == "psyker" => {
            set p.pierce = 10000
            set p.orbit_distance = rfloat(56, 64)
            set p.orbit_speed = rfloat(2, 4)*(match p.parent.orbitism { 1 => 1.25 ; 2 => 1.5 ; 3 => 1.75 ; else => 1 })*(1/p.parent.aspd_m)
            set p.orbit_offset = rfloat(0, 2*math.pi)
            set p.dmg = p.dmg*(match p.parent.psychosink { 1 => 1.4 ; 2 => 1.8 ; 3 => 2.2 ; else => 1 })
        }
        c == "lich" => {
            spring_pull(p.hit.s, 0.15)
            spawn @ps Trail(p, fx, false)
        }
        c == "arcanist" => {
            set p.dmg = 0.2*p.dmg
            spawn @ps Trail(p, fx, true)
            spawn @ps ArcanistShots(A, p, fx)
        }
        (c == "witch") && (p.level == 3) => {
            set p.chain = 1
        }
    }
    if p.homing {
        spawn @ps Homing(p)
    }
    spawn {
        loop on :draw {
            if shown {
                ifs {
                    c == "sage" => {
                        eng.push(p.x, p.y, p.r + vr, p.hit.s.x)
                        eng.circle(p.x, p.y, st.rs + rfloat(-1, 1), p.color)
                        eng.circle(p.x, p.y, st.pull, alpha(p.color, 0.08))
                        val lw = remap(st.pull, 32, 256, 2, 4)
                        loop i in 4 {
                            eng.arc(:open, p.x, p.y, st.pull, i*math.pi/2 + math.pi/4 - math.pi/8,
                                    i*math.pi/2 + math.pi/4 + math.pi/8, p.color, lw)
                        }
                        eng.pop()
                    }
                    c == "lich" => {
                        eng.push(p.x, p.y, p.r, p.hit.s.x)
                        eng.circle(p.x, p.y, 3 + rfloat(-1, 1), p.color)
                        eng.pop()
                    }
                    c == "arcanist" => {
                        eng.push(p.x, p.y, p.r, p.hit.s.x)
                        eng.circle(p.x, p.y, 4, if p.hit.f > 0 => fg@0 => p.color)
                        eng.pop()
                    }
                    c == "psyker" => {
                        eng.push(p.x, p.y, p.r, p.hit.s.x)
                        eng.circle(p.x, p.y, 2.5, if p.hit.f > 0 => fg@0 => p.color)
                        eng.pop()
                    }
                    else => {
                        eng.push(p.x, p.y, p.r + orbit_r)
                        eng.rect(p.x, p.y, 10, 4, 2, 2, p.color)
                        eng.pop()
                    }
                }
            }
        }
    }
    val dx, dy, n = par :any {
        ;; flies
        var px, py = p.x, p.y
        loop us on :clock {
            val dt = us / 1000000
            set p.x, p.y = body_pos(p.b)
            ifs {
                c == "psyker" => {
                    ;; it circles its unit, and ends with it
                    until X.nin(p.parent, A.units)
                    val t = A.time
                    val x = p.parent.x + p.orbit_distance*math.cos(p.orbit_speed*t + p.orbit_offset)
                    val y = p.parent.y + p.orbit_distance*math.sin(p.orbit_speed*t + p.orbit_offset)
                    body_set(p.b, :position, x, y)
                    set p.r = math.atan2(y - py, x - px)
                    body_set(p.b, :angle, p.r)
                    set px, py = x, y
                }
                else => {
                    if c == "spellblade" {
                        set orbit_r += st.orbit_vr*dt
                    }
                    if p.homing_on {
                        val t = closest_enemy(A, p.x, p.y, 64)
                        if t {
                            rotate_towards_point(p.b, t.x, t.y, 0.1)
                            set p.r = body_angle(p.b)
                        }
                    }
                    body_set(p.b, :angle, p.r)
                    body_set(p.b, :velocity, p.v*math.cos(p.r + orbit_r), p.v*math.sin(p.r + orbit_r))
                    if c == "sage" {
                        loop _, e in enemies_in_circle(A, p.x, p.y, st.pull) {
                            val d = math.sqrt((e.x - p.x)*(e.x - p.x) + (e.y - p.y)*(e.y - p.y))
                            steer_force(e.st, remap(d, 0, 100, 250, 50), angle_to(e, p.x, p.y))
                        }
                        set vr += p.dvr*dt
                    }
                }
            }
        }
        (p.x, p.y, 0)
    } with {
        ;; the sage: 4s, blinks, and bursts at level 3
        if c != "sage" {
            await(false)
        }
        set p.dvr = rfloat(-math.pi/4, math.pi/4)
        await 4s
        loop i in 7 {
            if i > 0 {
                await 50ms
            }
            set shown = !shown
        }
        if p.level == 3 {
            play(rtable([saboteur_hit1, saboteur_hit2]), [pitch=rfloat(0.95, 1.05), volume=0.2])
            play(magic_area1, [pitch=rfloat(0.95, 1.05), volume=0.075])
            loop _, e in enemies_in_circle(A, p.x, p.y, st.pull) {
                hit(e, 3*p.compression_dmg)
            }
        }
        (p.x, p.y, rint(3, 4))
    } with {
        ;; hits the enemies it crosses, until it cannot cross more
        if c == "sage" {
            await(false)
        }
        loop e on :trigger.enter until (it.b == p.b) && (it.other.kind == :enemy) {
            val o = e.other
            val last = (p.pierce <= 0) && (p.chain <= 0)
            if !last {
                if p.pierce > 0 {
                    set p.pierce -= 1
                }
                if p.chain > 0 {
                    set p.chain -= 1
                    set hit_list@+ = o
                    val t = random_enemy(A, p.x, p.y, 48, hit_list)
                    if t {
                        set p.r = math.atan2(t.y - p.y, t.x - p.x)
                        if c == "lich" {
                            set p.v = p.v*1.1
                            if p.level == 3 {
                                slow_enemy(t, 0.2, 2)
                            }
                        } else {
                            set p.v = p.v*1.25
                        }
                        if (p.level == 3) && (c == "scout") {
                            set p.dmg = p.dmg*1.25
                        }
                    }
                }
                spawn @fx HitCircle(p.x, p.y, [rs=6, color=fg@0, duration=0.1])
                spawn @fx HitParticle(p.x, p.y, [color=p.color])
                spawn @fx HitParticle(p.x, p.y, [color=o.color])
            }
            projectile_sound(c)
            hit(o, p.dmg, [projectile=p])
            spawn @fx ProjectileHit(A, p, o, fx)
            if last {
                break (p.x, p.y, rint(2, 3))
            }
        }
    } with {
        ;; dies on a wall, or bounces
        loop e on :collision.enter until (it.b == p.b) && (it.other.kind == :wall) {
            ifs {
                X.xin(c, ["archer", "hunter", "barrage", "barrager", "sentry"]) => {
                    play(rtable([arrow_hit_wall1, arrow_hit_wall2]), [pitch=rfloat(0.9, 1.1), volume=0.2])
                    if p.ricochet <= 0 {
                        spawn @fx WallArrow(e.x, e.y, p.r, p.color)
                        break (e.x, e.y, 0)
                    }
                    bounce(p, e.nx, e.ny)
                    set p.ricochet -= 1
                }
                X.xin(c, ["scout", "outlaw", "blade", "spellblade", "jester", "beastmaster", "witch", "thief"]) => {
                    play(knife_hit_wall1, [pitch=rfloat(0.9, 1.1), volume=0.2])
                    bounce(p, e.nx, e.ny)
                    spawn @fx WallKnife(A, e.x, e.y, p.r, p.v*0.1, p.color, fx)
                    if c == "spellblade" {
                        play(magic_area1, [pitch=rfloat(0.95, 1.05), volume=0.075])
                    }
                    break (e.x, e.y, 0)
                }
                c == "artificer_death" => {
                    if p.ricochet <= 0 {
                        play(magic_area1, [pitch=rfloat(0.95, 1.05), volume=0.075])
                        break (e.x, e.y, rint(2, 3))
                    }
                    bounce(p, e.nx, e.ny)
                    set p.ricochet -= 1
                }
                X.xin(c, ["wizard", "lich", "arcanist", "arcanist_projectile", "witch"]) => {
                    play(magic_area1, [pitch=rfloat(0.95, 1.05), volume=0.075])
                    break (e.x, e.y, rint(2, 3))
                }
                c == "cannoneer" => {
                    play(cannon_hit_wall1, [pitch=rfloat(0.95, 1.05), volume=0.1])
                    break (e.x, e.y, rint(2, 3))
                }
                X.xin(c, ["engineer", "dual_gunner", "miner"]) => {
                    play(rtable([turret_hit_wall1, turret_hit_wall2]), [pitch=rfloat(0.9, 1.1), volume=0.2])
                    break (e.x, e.y, rint(2, 3))
                }
                c == "psyker" => nil
                else => {
                    play(proj_hit_wall1, [pitch=rfloat(0.9, 1.1), volume=0.2])
                    break (e.x, e.y, rint(2, 3))
                }
            }
        }
    }
    ;; as `Projectile:die`
    loop _ in n {
        spawn @fx HitParticle(dx, dy, [r=rfloat(0, 2*math.pi), color=p.color])
    }
    spawn @fx HitCircle(dx, dy, [scale_down=true])
    val pp = p.parent
    match c {
        "wizard" => spawn @fx Area(A, [x=p.x, y=p.y, r=p.r, w=pp.area_size_m*24, color=p.color,
                                        dmg=pp.area_dmg_m*p.dmg, character=c, level=p.level, parent=pp], fx)
        "blade" => spawn @fx Area(A, [x=p.x, y=p.y, r=p.r, w=pp.area_size_m*64, color=p.color,
                                       dmg=pp.area_dmg_m*p.dmg, character=c, level=p.level, parent=pp], fx)
        "cannoneer" => {
            spawn @fx Area(A, [x=p.x, y=p.y, r=p.r, w=pp.area_size_m*96, color=p.color,
                               dmg=2*pp.area_dmg_m*p.dmg, character=c, level=p.level, parent=pp], fx)
            if p.level == 3 {
                spawn @fx Bombard(A, p, fx)
            }
        }
    }
}

;; The parts of some projectiles, beside their flight.

;; The orb of the sage grows, and bounces.
task SageGrow (p, st) {
    await Tween(0.05, st, [rs=10/2.5], cubic_in_out)
    spring_pull(p.hit.s, 0.15)
}

;; Particles behind a projectile, every 0.08s (the arcanist's go back,
;; spread a little).
task Trail (p, fx, back) {
    loop {
        await 80ms
        if back {
            spawn @fx HitParticle(p.x, p.y, [color=p.color, r=p.r + math.pi + rfloat(-math.pi/6, math.pi/6), v=rfloat(10, 25)])
        } else {
            spawn @fx HitParticle(p.x, p.y, [color=p.color])
        }
    }
}

;; The spin of the knife of the spellblade slows down, and stops.
task SpellOrbit (p, st) {
    await Tween(6.25, st, [orbit_vr=(if p.level == 3 => 4*math.pi => math.pi)], expo_out)
    await Tween(12.25, st, [orbit_vr=0], linear)
}

;; A projectile turns to the closest enemy, after 0.1s.
task Homing (p) {
    await 100ms
    set p.homing_on = true
}

;; The ball of the arcanist shoots at the enemies around it (one, or two
;; at level 3), every 0.8s (0.54s at level 3).
task ArcanistShots (A, p, fx) {
    pin fxs = tasks()
    loop {
        await((if p.parent.level == 3 => 0.54 => 0.8) * 1s)
        val es = enemies_in_circle(A, p.x, p.y, 128)
        loop i, e in es {
            while i < (if p.level == 3 => 2 => 1)
            play(arcane2, [pitch=rfloat(0.7, 1.3), volume=0.15])
            spawn @fxs HfxUse(p.hit, 0.5)
            val r = angle_to(p, e.x, e.y)
            spawn @fx Projectile(A, [x=p.x + 8*math.cos(r), y=p.y + 8*math.sin(r), v=250, r=r,
                color=p.parent.color, dmg=p.parent.dmg, pierce=2, character="arcanist_projectile",
                parent=p.parent, level=p.parent.level], fx)
        }
    }
}

;; After a shot of a cannoneer of level 3: seven smaller areas around the
;; place, 0.3s apart (`every(0.3, ..., 7)`).
task Bombard (A, p, fx) {
    val pp = p.parent
    loop _ in 7 {
        await 300ms
        play(rtable([cannoneer1, cannoneer2]), [pitch=rfloat(0.95, 1.05), volume=0.5])
        spawn @fx Area(A, [x=p.x + rfloat(-32, 32), y=p.y + rfloat(-32, 32), r=p.r + rfloat(0, 2*math.pi),
            w=pp.area_size_m*48, color=p.color, dmg=0.5*pp.area_dmg_m*p.dmg, character="cannoneer", level=p.level, parent=pp], fx)
    }
}

;; What follows a hit of a projectile on an enemy, after its damage
;; (`Projectile:on_trigger_enter`, `player.lua:2343-2414`): the area of a
;; wizard of level 3, the pets of the hunter, the damage over time of the
;; assassin; a crit shakes the screen, and a projectile with `knockback`
;; pushes.
task ProjectileHit (A, p, o, fx) {
    val pp = p.parent
    if (p.character == "wizard") && (p.level == 3) {
        spawn @fx Area(A, [x=p.x, y=p.y, r=p.r, w=pp.area_size_m*32, color=p.color,
                           dmg=pp.area_dmg_m*p.dmg, character="wizard", parent=pp], fx)
    }
    if p.character == "assassin" {
        dot(o, (if p.crit => 4*p.dmg => p.dmg/2)*(pp.dot_dmg_m || 1)*(A.chronomancer_dot || 1), 3)
    }
    if p.crit {
        shake(5, 0.25)
        play(rogue_crit1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        play(rogue_crit2, [pitch=rfloat(0.95, 1.05), volume=0.15])
        loop _ in 3 {
            spawn @fx HitParticle(o.x, o.y, [color=p.color, v=rfloat(100, 400)])
        }
        loop _ in 3 {
            spawn @fx HitParticle(o.x, o.y, [color=o.color, v=rfloat(100, 400)])
        }
        spawn @fx HitCircle(o.x, o.y, [rs=12, color=fg@0, duration=0.3, scale_down=true, change_color=[0.5, p.color]])
    }
    if p.knockback {
        push(o, p.knockback*(p.knockback_m || 1), p.r)
    }
    if (p.character == "hunter") && rbool(40) {
        val r = angle_to(pp, o.x, o.y)
        if p.level == 3 {
            ;; the pets come out at the peak of a spawn effect at the hunter
            await SpawnEffect(pp.x, pp.y, green@0, fx)
            spawn @fx Pet(A, pp.x, pp.y, r, 150, pp, fx)
            spawn @fx Pet(A, pp.x + 12*math.cos(r + math.pi/2), pp.y + 12*math.sin(r + math.pi/2), r, 150, pp, fx)
            spawn @fx Pet(A, pp.x + 12*math.cos(r - math.pi/2), pp.y + 12*math.sin(r - math.pi/2), r, 150, pp, fx)
        } else {
            await SpawnEffect(pp.x, pp.y, orange@0, fx)
            spawn @fx Pet(A, pp.x, pp.y, r, 150, pp, fx)
        }
    }
}

;; As `WallArrow`: an arrow stuck in the wall, which blinks away after
;; 0.8 to 2s.
task WallArrow (x, y, r, color) {
    val h = hfx(1)
    spawn Springs(h.s)
    spawn HfxUse(h, 0.25)
    var shown = true
    spawn {
        loop on :draw {
            if shown {
                eng.push(x, y, r, h.s.x)
                eng.rect(x, y, 10, 4, 2, 2, if h.f > 0 => fg@0 => color)
                eng.pop()
            }
        }
    }
    await(rfloat(0.8, 2) * 1s)
    loop i in 7 {
        if i > 0 {
            await 50ms
        }
        set shown = !shown
    }
}

;; As `WallKnife`: a knife that bounces off the wall, spinning, slows down
;; in 0.8 to 1.6s, and blinks away.
task WallKnife (A, x, y, r, v, color, fx) {
    val k = [ kind=:knife, w=10, h=4, x=x, y=y, r=r, v=v, vr=r ]
    body(A.w, k, :dynamic, x, y, :projectile, [:rect, 10, 4])
    defer {
        body_free(A.w, k.b)
    }
    val h = hfx(1)
    spawn Springs(h.s)
    spawn HfxUse(h, 0.25)
    val dvr = rtable([rfloat(-8*math.pi, -4*math.pi), rfloat(4*math.pi, 8*math.pi)])
    var shown = true
    spawn {
        loop on :draw {
            if shown {
                eng.push(k.x, k.y, k.vr, h.s.x)
                eng.rect(k.x, k.y, 10, 4, 2, 2, if h.f > 0 => fg@0 => color)
                eng.pop()
            }
        }
    }
    spawn {
        loop us on :clock {
            set k.x, k.y = body_pos(k.b)
            body_set(k.b, :angle, k.r)
            body_set(k.b, :velocity, k.v*math.cos(k.r), k.v*math.sin(k.r))
            set k.vr += dvr*(us / 1000000)
        }
    }
    await Tween(rfloat(0.8, 1.6), k, [v=0], linear)
    loop i in 7 {
        if i > 0 {
            await 50ms
        }
        set shown = !shown
    }
}

;; The sound of a projectile that hits an enemy.
func projectile_sound (c) {
    ifs {
        X.xin(c, ["archer", "scout", "outlaw", "blade", "hunter", "spellblade", "engineer", "jester", "assassin",
                  "barrager", "beastmaster", "witch", "miner", "thief", "psyker", "sentry"]) => {
            play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
            if X.xin(c, ["spellblade", "psyker"]) {
                play(magic_area1, [pitch=rfloat(0.95, 1.05), volume=0.15])
            }
        }
        X.xin(c, ["wizard", "lich", "arcanist"]) =>
            play(magic_area1, [pitch=rfloat(0.95, 1.05), volume=0.15])
        c == "arcanist_projectile" =>
            play(magic_area1, [pitch=rfloat(0.95, 1.05), volume=0.075])
        else =>
            play(hit3, [pitch=rfloat(0.95, 1.05), volume=0.35])
    }
}

;;; AREAS ;;;

;; As `Area`: a square that hits the enemies under it at once, and then
;; shows for a moment and blinks away.
task Area (A, a, fx) {
    val w = a.w
    val shape = rect_corners(a.x, a.y, 1.5*w, 1.5*w, a.r)
    val es = []
    loop _, e in A.enemies {
        if polys_overlap(shape, rect_corners(e.x, e.y, e.w, e.h, e.r)) {
            set es@+ = e
        }
    }
    loop _, e in es {
        val dmg = if a.character == "swordsman" => (a.dmg + a.dmg*0.15*#es) => a.dmg
        hit(e, dmg, [area=a])
        spawn @fx HitCircle(e.x, e.y, [rs=6, color=fg@0, duration=0.1])
        spawn @fx HitParticle(e.x, e.y, [color=a.color])
        spawn @fx HitParticle(e.x, e.y, [color=e.color])
        ifs {
            X.xin(a.character, ["wizard", "magician"]) =>
                play(magic_hit1, [pitch=rfloat(0.95, 1.05), volume=0.5])
            a.character == "swordsman" =>
                play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
        }
    }
    val st = [ w=0, color=fg@0 ]
    val faint = alpha(a.color, 0.08)
    val s = spring(1)
    spawn Springs(s)
    var shown = true
    spawn {
        loop on :draw {
            if shown {
                eng.push(a.x, a.y, a.r, s.x)
                val h = st.w/2
                val t = st.w/10
                val x1 = a.x - h
                val y1 = a.y - h
                val x2 = a.x + h
                val y2 = a.y + h
                val lw = remap(h, 32, 256, 2, 4)
                eng.polyline([x1, y1 + t, x1, y1, x1 + t, y1], st.color, lw)
                eng.polyline([x2 - t, y1, x2, y1, x2, y1 + t], st.color, lw)
                eng.polyline([x2 - t, y2, x2, y2, x2, y2 - t], st.color, lw)
                eng.polyline([x1, y2 - t, x1, y2, x1 + t, y2], st.color, lw)
                eng.rect((x1 + x2)/2, (y1 + y2)/2, x2 - x1, y2 - y1, nil, nil, faint)
                eng.pop()
            }
        }
    }
    spawn {
        await Tween(0.05, st, [w=w], cubic_in_out)
        spring_pull(s, 0.15)
    }
    await 200ms
    set st.color = a.color
    ;; blinks 7 times, as `every_immediate(0.05, ..., 7)`
    loop i in 7 {
        if i > 0 {
            await 50ms
        }
        set shown = !shown
    }
}

;;; SHOOTING ;;;

;; As `Player:shoot(r, mods)`: projectiles from the unit along `r`.
func shoot_args (u, r, mods) {
    [
        x = u.x + 1.6*9*math.cos(r), y = u.y + 1.6*9*math.sin(r),
        v = 250, r = r, color = u.color, dmg = u.dmg, character = u.character,
        parent = u, level = u.level,
    ] ++ (mods || [])
}

;; The sound of a shot.
func shoot_sound (c) {
    ifs {
        X.xin(c, ["vagrant", "artificer"]) => play(shoot1, [pitch=rfloat(0.95, 1.05), volume=0.2])
        c == "dual_gunner" => {
            play(dual_gunner1, [pitch=rfloat(0.95, 1.05), volume=0.3])
            play(dual_gunner2, [pitch=rfloat(0.95, 1.05), volume=0.3])
        }
        X.xin(c, ["archer", "hunter", "barrager", "corruptor"]) =>
            play(archer1, [pitch=rfloat(0.95, 1.05), volume=0.35])
        X.xin(c, ["wizard", "lich", "arcanist"]) =>
            play(wizard1, [pitch=rfloat(0.95, 1.05), volume=0.15])
        X.xin(c, ["scout", "outlaw", "blade", "spellblade", "jester", "assassin", "beastmaster", "thief"]) => {
            play(rtable([scout1, scout2]), [pitch=rfloat(0.95, 1.05), volume=0.35])
            if c == "spellblade" {
                play(wizard1, [pitch=rfloat(0.95, 1.05), volume=0.15])
            }
        }
        c == "cannoneer" => play(rtable([cannoneer1, cannoneer2]), [pitch=rfloat(0.95, 1.05), volume=0.5])
    }
    if c == "lich" {
        play(frost1, [pitch=rfloat(0.95, 1.05), volume=0.3])
    }
    if c == "arcanist" {
        play(arcane1, [pitch=rfloat(0.95, 1.05), volume=0.3])
    }
}
