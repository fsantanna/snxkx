;; The enemies of the arena: the seeker (`Seeker` of `enemies.lua`),
;; without its elite variants yet.
;;
;; A seeker chases the leader of the snake, wandering and keeping apart
;; from the others, until something pushes it: then it tumbles, with no
;; steering, until it slows down below 25, and chases again. The
;; original keeps `being_pushed` and `steering_enabled` for that; here
;; they are the two phases of a loop.

;; As `Seeker:push(f, r)`: an impulse, a spin, and damping (a boss is
;; pushed less).
func seeker_push (e, f, r) {
    val n = ifs {
        e.boss && (e.level % 25 == 0) => 0.7
        e.boss => 0.2
        e.elite == "tank" => 0.7
        else => 1
    }
    set e.push_force = n*f
    body_set(e.b, :impulse, n*f*math.cos(r), n*f*math.sin(r))
    body_set(e.b, :angular_impulse,
        rtable([rfloat(-12*math.pi, -4*math.pi), rfloat(4*math.pi, 12*math.pi)]))
    body_set(e.b, :damping, 1.5*(1/n))
    body_set(e.b, :angular_damping, 1.5*(1/n))
}

;; The colors of the elites and bosses.
val ELITE_COLORS = [
    speed_booster=green@0, exploder=blue@0, shooter=fg@0, headbutter=orange@0,
    tank=yellow@0, spawner=purple@0, swarmer=purple@0, forcer=yellow@0,
]

;; A seeker. `e` has `x`, `y`, and `level`, and maybe `elite` or `boss`
;; (a name of the original).
task Seeker (A, e, fx, shots) {
    trace("add", string.format("Seeker %.1f %.1f", e.x, e.y))
    set e.kind    = :enemy
    set e.hit     = hfx(1)
    set e.hp_shown = 0
    set e.r = 0
    set e.aiming = 0
    set e.boost = 1
    if e.boss {
        set e.stats   = :boss
        set e.classes = [:mini_boss]
        set e.w = 18
        set e.h = 7
    } else {
        set e.stats   = :seeker
        set e.classes = [:seeker]
        set e.w = 14
        set e.h = 6
    }
    set e.color = ELITE_COLORS@(e.boss || e.elite) || red@0
    unit_stats(e, true, A.ng)
    body(A.w, e, :dynamic, e.x, e.y, :enemy, [:rect, e.w, e.h])
    body_restitution(e.b, 0.5)
    val st = if e.boss => steerable(e.b, e.v, 1000, 2*math.pi, 2) => steerable(e.b, e.v, 2000, 4*math.pi, 4)
    set e.st = st
    set e.stunned = false
    spawn SpeedBoosts(e)
    spawn SeekerSlows(e)
    pin dots = tasks()
    spawn {
        loop d on :Dot until it.to == e {
            spawn @dots Dot(e, d.dmg, d.duration, d.color, fx)
        }
    }
    spawn {
        if e.boss {
            await BossAttack(A, e, fx)
        } else {
            await EliteAttack(A, e, fx, shots)
        }
    }
    set A.enemies@+ = e
    defer {
        body_free(A.w, e.b)
        val es = []
        loop _, o in A.enemies {
            if o != e {
                set es@+ = o
            }
        }
        set A.enemies = es
    }
    spawn Springs(e.hit.s)
    ;; the effects of the seeker (a flash, its bar of hp), which live with it
    pin fxs = tasks()

    spawn {
        loop on :draw {
            eng.push(e.x, e.y, e.r, e.hit.s.x)
            eng.rect(e.x, e.y, e.w, e.h, if e.boss => 4 => 3, if e.boss => 4 => 3,
                     if e.hit.f > 0 => fg@0 => e.color)
            eng.pop()
            if e.boss {
                eng.line(e.x - e.w/2, e.y + 8, e.x + e.w/2, e.y + 8, bg@(-3), 2)
                eng.line(e.x - e.w/2, e.y + 8, e.x - e.w/2 + e.w*(e.attack_ratio || 0), e.y + 8, e.color, 2)
            }
            draw_hp_bar(e, e.w, e.h, red@0)
        }
    }

    ;; the walls
    spawn {
        loop c on :collision.enter until (it.b == e.b) && (it.other.kind == :wall) {
            spawn @fxs HfxUse(e.hit, 0.15, 200, 10, 0.1)
            bounce(e, c.nx, c.ny)
        }
    }

    var last = nil              ;; the last hit
    par :any {
        ;; the life of the seeker: until its hp ends
        loop h on :Hit until it.to == e {
            set last = h
            spawn @fxs HfxUse(e.hit, 0.25, 200, 10)
            if !e.push_invulnerable {
                spawn @fxs ShowHp(e)
                var dmg = math.max(unit_damage(e, h.dmg)*(if e.stunned => 2 => 1), 0)
                if e.vulnerable {
                    set dmg = dmg*e.vulnerable
                }
                set e.hp = math.min(e.hp - dmg, e.max_hp)
                set A.damage_dealt += dmg
                val pj = h.projectile
                if pj && pj.spawn_critters_on_hit {
                    play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                    loop _ in pj.spawn_critters_on_hit {
                        spawn @shots Critter(A, e.x, e.y, rfloat(0, 2*math.pi), 10, pj.parent.dmg, pj.parent, fx)
                    }
                }
            }
            until e.hp <= 0
        }
    } with {
        ;; the position and the speed, in every tick
        loop on :clock {
            set e.x, e.y = body_pos(e.b)
            set e.r = body_angle(e.b)
            set e.buff_def_a = match (A.cl && A.cl.mage) { 2 => -30 ; 1 => -15 ; else => 0 }
            set e.buff_mvspd_m = e.boost * (e.slowed || 1) * (if e.elite == "tank" => 0.35 => 1)
            unit_stats(e, false, A.ng)
            set st.max_v = e.max_v
            if (e.boost > 1) && !e.elite && !e.boss {
                ;; a boosted seeker goes from green to red along its boost
                val k = 3 + 0.015*e.level
                val n = e.boost / k
                val gr, gg, gb = comps(green@0)
                val rr, rg, rb = comps(red@0)
                set e.color = rgba(remap(n, 1, 0.5, gr, rr), remap(n, 1, 0.5, gg, rg), remap(n, 1, 0.5, gb, rb))
            }
        }
    } with {
        loop {
            ;; chasing
            var p = par :any {
                loop on :clock {
                    steer_update(st)
                    val l = A.units@0
                    ifs {
                        e.aiming > 0 => {
                            ;; aims at the leader (a shooter, a headbutter charging)
                            body_set(e.b, :damping, 10)
                            if l {
                                rotate_towards_point(e.b, l.x, l.y, 0.5)
                            }
                        }
                        e.headbutting => nil
                        e.boss => {
                            ;; toward the middle of the other enemies
                            var x, y = 0, 0
                            if #A.enemies > 1 {
                                loop _, o in A.enemies {
                                    set x += o.x
                                    set y += o.y
                                }
                                set x = x / #A.enemies
                                set y = y / #A.enemies
                            } else {
                                if l {
                                    set x = l.x
                                    set y = l.y
                                }
                            }
                            seek_point(st, x, y)
                            wander(st, 10, 250, 3)
                            separate(st, 16, A.enemies)
                            rotate_towards_velocity(e.b, 0.5)
                        }
                        else => {
                            if l {
                                seek_point(st, l.x, l.y)
                            }
                            wander(st, 50, 100, 20)
                            separate(st, 16, A.enemies)
                            rotate_towards_velocity(e.b, 0.5)
                        }
                    }
                }
            } with {
                await :Push until it.to == e
            }
            ;; pushed: tumbling with no steering, pushed again or not
            loop {
                set e.push_invulnerable = p.inv
                seeker_push(e, p.f, p.r)
                set p = par :any {
                    loop on :clock {
                        val vx, vy = body_vel(e.b)
                        until math.sqrt(vx*vx + vy*vy) < 25
                    }
                    nil
                } with {
                    await :Push until it.to == e
                } with {
                    ;; fast, it hits and pushes the enemies it meets, and is
                    ;; hit back (`Seeker:on_collision_enter`, `enemies.lua:414-421`)
                    loop c on :collision.enter until (it.b == e.b) && (it.other.kind == :enemy) {
                        val vx, vy = body_vel(e.b)
                        if math.sqrt(vx*vx + vy*vy) > 60 {
                            val o = c.other
                            hit(o, math.floor(e.push_force/4), [from_enemy=true])
                            hit(e, math.floor(e.push_force/2), [from_enemy=true])
                            push(o, math.floor(e.push_force/2), angle_to(o, e.x, e.y))
                            spawn @fx HitCircle(c.x, c.y, [rs=6, color=fg@0, duration=0.1])
                            loop _ in 2 {
                                spawn @fx HitParticle(c.x, c.y, [color=e.color])
                            }
                            play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
                        }
                    }
                }
                until p == nil
            }
            set e.push_invulnerable = false
            body_set(e.b, :damping, 0)
            body_set(e.b, :angular_damping, 0)
        }
    }

    ;; death, as the end of `Seeker:hit`
    trace("enemy.die", e.boss || e.elite || "seeker")
    val pj = last && last.projectile
    if pj && pj.spawn_critters_on_kill {
        play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        loop _ in pj.spawn_critters_on_kill {
            spawn @shots Critter(A, e.x, e.y, rfloat(0, 2*math.pi), 5, pj.parent.dmg, pj.parent, fx)
        }
    }
    if e.boss {
        slow(0.25, 1)
        play(magic_die1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    }
    if e.elite == "speed_booster" {
        spawn @fx BoostAround(A, e, nil, 3, fx)
    }
    if e.elite == "exploder" {
        play(mine1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        spawn @shots ExploderMine(A, e.x, e.y, e, fx, shots)
    }
    loop _ in rint(4, 6) {
        spawn @fx HitParticle(e.x, e.y, [color=e.color])
    }
    spawn @fx HitCircle(e.x, e.y, [rs=12, scale_down=true, duration=0.3, change_color=[0.5, e.color]])
    play(rtable([enemy_die1, enemy_die2]), [pitch=rfloat(0.9, 1.1), volume=0.5])
}

;; The slows of a seeker (`Seeker:slow`): `e.slowed` while a slow lasts,
;; and a new slow restarts it, as the tagged timer of the original.
task SeekerSlows (e) {
    loop {
        var s = await :Slowed until it.to == e
        loop {
            set e.slowed = s.amount
            set s = par :any {
                await(s.duration * 1s)
                nil
            } with {
                await :Slowed until it.to == e
            }
            until !s
        }
        set e.slowed = nil
    }
}

;; A damage over time on a seeker (`Seeker:apply_dot`): a quarter of `dmg`
;; every 0.25s, `duration/0.2` times.
task Dot (e, dmg, duration, color, fx) {
    loop _ in math.floor(duration/0.2) {
        await 250ms
        play(hit2, [pitch=rfloat(0.8, 1.2), volume=0.2])
        hit(e, dmg/4, [dot=true])
        spawn @fx HitCircle(e.x, e.y, [rs=6, color=fg@0, duration=0.1])
        spawn @fx HitParticle(e.x, e.y, [color=e.color])
        spawn @fx HitParticle(e.x, e.y, [color=color || purple@0])
    }
}
