;; The enemies of the arena: the seeker (`Seeker` of `enemies.lua`),
;; without its elite variants yet.
;;
;; A seeker chases the leader of the snake, wandering and keeping apart
;; from the others, until something pushes it: then it tumbles, with no
;; steering, until it slows down below 25, and chases again. The
;; original keeps `being_pushed` and `steering_enabled` for that; here
;; they are the two phases of a loop.

;; As `Seeker:push(f, r)`: an impulse, a spin, and damping (a boss is
;; pushed less).
func seeker_push (e, f, r) {
    val n = ifs {
        e.boss && (e.level % 25 == 0) => 0.7
        e.boss => 0.2
        e.elite == "tank" => 0.7
        else => 1
    }
    set e.push_force = n*f
    body_set(e.b, :impulse, n*f*math.cos(r), n*f*math.sin(r))
    body_set(e.b, :angular_impulse,
        rtable([rfloat(-12*math.pi, -4*math.pi), rfloat(4*math.pi, 12*math.pi)]))
    body_set(e.b, :damping, 1.5*(1/n))
    body_set(e.b, :angular_damping, 1.5*(1/n))
}

;; The colors of the elites and bosses.
val ELITE_COLORS = [
    speed_booster=green@0, exploder=blue@0, shooter=fg@0, headbutter=orange@0,
    tank=yellow@0, spawner=purple@0, swarmer=purple@0, forcer=yellow@0,
]

;; A seeker. `e` has `x`, `y`, and `level`, and maybe `elite` or `boss`
;; (a name of the original).
task Seeker (A, e, fx, shots) {
    trace("add", string.format("Seeker %.1f %.1f", e.x, e.y))
    set e.kind    = :enemy
    set e.hit     = hfx(1)
    set e.hp_shown = 0
    set e.r = 0
    set e.aiming = 0
    set e.boost = 1
    if e.boss {
        set e.stats   = :boss
        set e.classes = [:mini_boss]
        set e.w = 18
        set e.h = 7
    } else {
        set e.stats   = :seeker
        set e.classes = [:seeker]
        set e.w = 14
        set e.h = 6
    }
    set e.color = ELITE_COLORS@(e.boss || e.elite) || red@0
    ;; the passives against the enemies (`enemies.lua:242-254`)
    set e.vulnerable = lv(passive_level(A, "vulnerability"), 1.1, 1.2, 1.3)
    if passive_level(A, "temporal_chains") {
        set e.temporal_chains_mvspd_m = 0.9      ;; 0.9 at every level, as the original
    }
    unit_stats(e, true, A.ng)
    val intimidation = passive_level(A, "intimidation")
    if intimidation && !e.boss && (e.elite != "tank") {
        set e.buff_hp_m = lv(intimidation, 0.9, 0.8, 0.7)
        unit_stats(e, false, A.ng)
        set e.hp = e.max_hp
    }
    body(A.w, e, :dynamic, e.x, e.y, :enemy, [:rect, e.w, e.h])
    body_restitution(e.b, 0.5)
    val st = if e.boss => steerable(e.b, e.v, 1000, 2*math.pi, 2) => steerable(e.b, e.v, 2000, 4*math.pi, 4)
    set e.st = st
    set e.stunned = false
    spawn SpeedBoosts(e)
    spawn SeekerSlows(e)
    pin dots = tasks()
    spawn {
        loop d on :Dot until it.to == e {
            spawn @dots Dot(e, d.dmg, d.duration, d.color, fx)
        }
    }
    pin curses = tasks()
    spawn {
        loop c on :Curse until it.to == e {
            play(buff1, [pitch=rfloat(0.65, 0.75), volume=0.25])
            match c.kind {
                :launcher => spawn @curses LauncherCurse(e, c)
                :jester => spawn @curses Cursed(e, "jester", [ lvl3=c.a1, ref=c.a2 ], c.duration)
                :bane => spawn @curses Cursed(e, "bane", [ lvl3=c.a1, ref=c.a2 ], c.duration)
                :infestor => spawn @curses Cursed(e, "infested", [ n=c.a1, dmg=c.a2, ref=c.a3 ], c.duration)
                :silencer => spawn @curses Cursed(e, "silenced", true, c.duration)
                :usurer => {
                    if c.a1 {
                        set e.usurer_count = (e.usurer_count || 0) + 1
                        if e.usurer_count == 3 {
                            play(usurer1, [pitch=rfloat(0.95, 1.05), volume=1])
                            play(rogue_crit1, [pitch=rfloat(0.95, 1.05), volume=1])
                            shake(4, 0.4)
                            set e.usurer_count = 0
                            hit(e, 50*c.a2.dmg)
                        }
                    }
                }
            }
            ;; the passives on a curse
            val wd = passive_level(A, "whispers_of_doom")
            if wd {
                set e.doom = (e.doom || 0) + 1
                if e.doom == lv(wd, 4, 3, 2) {
                    set e.doom = 0
                    hit(e, lv(wd, 100, 150, 200))
                    play(buff1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                    play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                }
            }
            val hx = passive_level(A, "hextouch")
            if hx {
                dot(e, lv(hx, 10, 15, 20)*leader_dot(A)*(A.chronomancer_dot || 1), 3)
            }
        }
    }
    spawn {
        loop t on :Taunt until it.to == e {
            spawn @curses Cursed(e, "taunted", t.by, 4)
        }
    }
    spawn {
        loop t on :Stun until it.to == e {
            spawn @curses TimedField(e, "stunned", true, false, t.d)
        }
    }
    spawn {
        if e.boss {
            await BossAttack(A, e, fx)
        } else {
            await EliteAttack(A, e, fx, shots)
        }
    }
    set A.enemies@+ = e
    defer {
        body_free(A.w, e.b)
        val es = []
        loop _, o in A.enemies {
            if o != e {
                set es@+ = o
            }
        }
        set A.enemies = es
    }
    spawn Springs(e.hit.s)
    ;; the effects of the seeker (a flash, its bar of hp), which live with it
    pin fxs = tasks()

    spawn {
        loop on :draw {
            eng.push(e.x, e.y, e.r, e.hit.s.x)
            eng.rect(e.x, e.y, e.w, e.h, if e.boss => 4 => 3, if e.boss => 4 => 3,
                     if e.hit.f > 0 => fg@0 => e.color)
            eng.pop()
            if e.boss {
                eng.line(e.x - e.w/2, e.y + 8, e.x + e.w/2, e.y + 8, bg@(-3), 2)
                eng.line(e.x - e.w/2, e.y + 8, e.x - e.w/2 + e.w*(e.attack_ratio || 0), e.y + 8, e.color, 2)
            }
            draw_hp_bar(e, e.w, e.h, red@0)
        }
    }

    ;; the walls
    spawn {
        loop c on :collision.enter until (it.b == e.b) && (it.other.kind == :wall) {
            spawn @fxs HfxUse(e.hit, 0.15, 200, 10, 0.1)
            bounce(e, c.nx, c.ny)
            ;; thrown by a juggernaut or a launcher, it hurts itself
            if e.juggernaut_push {
                hit(e, e.juggernaut_push)
                play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
            }
            if e.launcher_push {
                hit(e, e.launcher_push)
                play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
            }
        }
    }

    var last = nil              ;; the last hit
    par :any {
        ;; the life of the seeker: until its hp ends
        loop h on :Hit until it.to == e {
            set last = h
            spawn @fxs HfxUse(e.hit, 0.25, 200, 10)
            if !e.push_invulnerable {
                spawn @fxs ShowHp(e)
                val strike = !h.dot && !h.from_enemy
                var crit = 1
                if strike {
                    spawn @fxs Strikes(A, e, h, fx)
                    val cs = passive_level(A, "critical_strike")
                    if cs && rbool(lv(cs, 5, 10, 15)) {
                        set crit = 2
                        spawn @fx CritFx(e, fx)
                    }
                }
                var dmg = math.max(unit_damage(e, h.dmg)*(if e.stunned => 2 => 1)*crit, 0)
                if e.vulnerable {
                    set dmg = dmg*e.vulnerable
                }
                set e.hp = math.min(e.hp - dmg, e.max_hp)
                set A.damage_dealt += dmg
                if strike {
                    val ns = passive_level(A, "noxious_strike")
                    if ns && rbool(lv(ns, 8, 16, 24)) {
                        dot(e, 0.6*dmg*leader_dot(A)*(A.chronomancer_dot || 1), 3)
                    }
                    if passive_level(A, "burning_strike") && rbool(15) {
                        dot(e, 0.6*dmg*leader_dot(A)*(A.chronomancer_dot || 1), 3, red@0)
                    }
                }
                if h.dot {
                    ;; a damage over time lowers its defense and its speed for 1s
                    spawn @fxs Cursed(e, "seeping_def_m", lv(passive_level(A, "seeping"), 0.85, 0.75, 0.65, 1), 1)
                    spawn @fxs Cursed(e, "deceleration_mvspd_m", lv(passive_level(A, "deceleration"), 0.85, 0.75, 0.65, 1), 1)
                }
                val cull = passive_level(A, "culling_strike")
                if e.boss && cull && (e.hp <= (e.max_hp*lv(cull, 0.1, 0.2, 0.3))) {
                    set e.hp = 0
                }
                val pj = h.projectile
                if pj && pj.spawn_critters_on_hit {
                    play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                    loop _ in pj.spawn_critters_on_hit {
                        spawn @shots Critter(A, e.x, e.y, rfloat(0, 2*math.pi), 10, pj.parent.dmg, pj.parent, fx)
                    }
                }
            }
            until e.hp <= 0
        }
    } with {
        ;; the position and the speed, in every tick
        loop on :clock {
            set e.x, e.y = body_pos(e.b)
            set e.r = body_angle(e.b)
            set e.buff_def_a = match (A.cl && A.cl.mage) { 2 => -30 ; 1 => -15 ; else => 0 }
            set e.buff_mvspd_m = e.boost * (e.slowed || 1) * (e.temporal_chains_mvspd_m || 1) *
                (if e.elite == "tank" => 0.35 => 1) * (e.deceleration_mvspd_m && e.deceleration_mvspd_m.v || 1)
            set e.buff_def_m = e.seeping_def_m && e.seeping_def_m.v || 1
            unit_stats(e, false, A.ng)
            set st.max_v = e.max_v
            if (e.boost > 1) && !e.elite && !e.boss {
                ;; a boosted seeker goes from green to red along its boost
                val k = 3 + 0.015*e.level
                val n = e.boost / k
                val gr, gg, gb = comps(green@0)
                val rr, rg, rb = comps(red@0)
                set e.color = rgba(remap(n, 1, 0.5, gr, rr), remap(n, 1, 0.5, gg, rg), remap(n, 1, 0.5, gb, rb))
            }
        }
    } with {
        loop {
            ;; chasing
            var p = par :any {
                loop on :clock {
                    steer_update(st)
                    ;; the leader, or a construct that taunts it
                    val l = (e.taunted && e.taunted.v.alive && e.taunted.v) || A.units@0
                    ifs {
                        e.aiming > 0 => {
                            ;; aims at the leader (a shooter, a headbutter charging)
                            body_set(e.b, :damping, 10)
                            if l {
                                rotate_towards_point(e.b, l.x, l.y, 0.5)
                            }
                        }
                        e.headbutting => nil
                        e.boss => {
                            ;; toward the middle of the other enemies
                            var x, y = 0, 0
                            if #A.enemies > 1 {
                                loop _, o in A.enemies {
                                    set x += o.x
                                    set y += o.y
                                }
                                set x = x / #A.enemies
                                set y = y / #A.enemies
                            } else {
                                if l {
                                    set x = l.x
                                    set y = l.y
                                }
                            }
                            seek_point(st, x, y)
                            wander(st, 10, 250, 3)
                            separate(st, 16, A.enemies)
                            rotate_towards_velocity(e.b, 0.5)
                        }
                        else => {
                            if l {
                                seek_point(st, l.x, l.y)
                            }
                            wander(st, 50, 100, 20)
                            separate(st, 16, A.enemies)
                            rotate_towards_velocity(e.b, 0.5)
                        }
                    }
                }
            } with {
                await :Push until it.to == e
            }
            ;; pushed: tumbling with no steering, pushed again or not
            loop {
                set e.push_invulnerable = p.inv
                seeker_push(e, p.f, p.r)
                set p = par :any {
                    loop on :clock {
                        val vx, vy = body_vel(e.b)
                        until math.sqrt(vx*vx + vy*vy) < 25
                    }
                    nil
                } with {
                    await :Push until it.to == e
                } with {
                    ;; thrown against a wall (heavy impact, tremor, fracture)
                    loop c on :collision.enter until (it.b == e.b) && (it.other.kind == :wall) {
                        spawn @fx PushedOnWall(A, e, fx, shots)
                    }
                } with {
                    ;; fast, it hits and pushes the enemies it meets, and is
                    ;; hit back (`Seeker:on_collision_enter`, `enemies.lua:414-421`)
                    loop c on :collision.enter until (it.b == e.b) && (it.other.kind == :enemy) {
                        val vx, vy = body_vel(e.b)
                        if math.sqrt(vx*vx + vy*vy) > 60 {
                            val o = c.other
                            hit(o, math.floor(e.push_force/4), [from_enemy=true])
                            hit(e, math.floor(e.push_force/2), [from_enemy=true])
                            push(o, math.floor(e.push_force/2), angle_to(o, e.x, e.y))
                            spawn @fx HitCircle(c.x, c.y, [rs=6, color=fg@0, duration=0.1])
                            loop _ in 2 {
                                spawn @fx HitParticle(c.x, c.y, [color=e.color])
                            }
                            play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
                        }
                    }
                }
                until p == nil
            }
            set e.push_invulnerable = false
            set e.juggernaut_push = nil
            set e.launcher_push = nil
            body_set(e.b, :damping, 0)
            body_set(e.b, :angular_damping, 0)
        }
    }

    ;; death, as the end of `Seeker:hit`
    trace("enemy.die", e.boss || e.elite || "seeker")
    ;; the curses act on death
    if last && last.pyrod {
        val d = last.pyrod
        spawn @fx Area(A, [x=e.x, y=e.y, color=red@0, w=32*d.parent.area_size_m, r=rfloat(0, 2*math.pi),
            dmg=d.parent.area_dmg_m*d.dmg, character=d.character, level=d.level, parent=d.parent], fx)
    }
    if e.jester {
        val j = e.jester.v
        play(rtable([scout1, scout2]), [pitch=rfloat(0.95, 1.05), volume=0.35])
        spawn @fx HitCircle(e.x, e.y, [rs=6])
        var r = rfloat(0, 2*math.pi)
        loop _ in 4 {
            spawn @shots Projectile(A, [x=e.x + 8*math.cos(r), y=e.y + 8*math.sin(r), v=250, r=r, color=red@0,
                dmg=j.ref.dmg, pierce=(if j.lvl3 => 2 => 0), homing=j.lvl3, character=j.ref.character, parent=j.ref], fx)
            set r += math.pi/2
        }
    }
    if e.bane {
        val b = e.bane.v.ref
        spawn @fx DotArea(A, [x=e.x, y=e.y, rs=(if b.level == 3 => 2 => 1)*b.area_size_m*27, color=purple@0,
            dmg=b.area_dmg_m*b.dmg*(b.dot_dmg_m || 1), void_rift=true, duration=1], fx)
    }
    if e.infested {
        val f = e.infested.v
        play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        loop _ in f.n {
            spawn @shots Critter(A, e.x, e.y, rfloat(0, 2*math.pi), 10, f.dmg, f.ref, fx)
        }
    }
    if !(last && last.from_enemy) {
        spawn @fx DeathPassives(A, e, fx, shots)
    }
    if (A.cl && A.cl.mercenary || 0) > 0 {
        if rbool(match A.cl.mercenary { 2 => 16 ; 1 => 8 ; else => 0 }) {
            spawn @shots Gold(A, e.x, e.y, fx, shots)
        }
    }
    val pj = last && last.projectile
    if pj && pj.spawn_critters_on_kill {
        play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        loop _ in pj.spawn_critters_on_kill {
            spawn @shots Critter(A, e.x, e.y, rfloat(0, 2*math.pi), 5, pj.parent.dmg, pj.parent, fx)
        }
    }
    if e.boss {
        slow(0.25, 1)
        play(magic_die1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    }
    val quiet = e.silenced || e.stunned         ;; no last act
    if (e.elite == "speed_booster") && !quiet {
        spawn @fx BoostAround(A, e, nil, 3, fx)
    }
    if (e.elite == "exploder") && !quiet {
        play(mine1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        spawn @shots ExploderMine(A, e.x, e.y, e, fx, shots)
    }
    loop _ in rint(4, 6) {
        spawn @fx HitParticle(e.x, e.y, [color=e.color])
    }
    spawn @fx HitCircle(e.x, e.y, [rs=12, scale_down=true, duration=0.3, change_color=[0.5, e.color]])
    play(rtable([enemy_die1, enemy_die2]), [pitch=rfloat(0.9, 1.1), volume=0.5])
}

;; The slows of a seeker (`Seeker:slow`): `e.slowed` while a slow lasts,
;; and a new slow restarts it, as the tagged timer of the original.
task SeekerSlows (e) {
    loop {
        var s = await :Slowed until it.to == e
        loop {
            set e.slowed = s.amount
            set s = par :any {
                await(s.duration * 1s)
                nil
            } with {
                await :Slowed until it.to == e
            }
            until !s
        }
        set e.slowed = nil
    }
}

;; A damage over time on a seeker (`Seeker:apply_dot`): a quarter of `dmg`
;; every 0.25s, `duration/0.2` times.
task Dot (e, dmg, duration, color, fx) {
    loop _ in math.floor(duration/0.2) {
        await 250ms
        play(hit2, [pitch=rfloat(0.8, 1.2), volume=0.2])
        hit(e, dmg/4, [dot=true])
        spawn @fx HitCircle(e.x, e.y, [rs=6, color=fg@0, duration=0.1])
        spawn @fx HitParticle(e.x, e.y, [color=e.color])
        spawn @fx HitParticle(e.x, e.y, [color=color || purple@0])
    }
}

;; A curse of a kind, as the tagged timer of the original: the field holds
;; it for `d` seconds, and a new curse of the kind replaces it (the old one
;; then expires without clearing it).
task Cursed (e, k, v, d) {
    val token = [ v=v ]
    set e@(k) = token
    await(d * 1s)
    if e@(k) == token {
        set e@(k) = nil
    }
}

;; A field for a while, and back (as `t:after(d, ...)` with no tag).
task TimedField (e, k, v, back, d) {
    set e@(k) = v
    await(d * 1s)
    set e@(k) = back
}

;; The curse of the launcher: after it, the enemy flies along an axis, and
;; hits itself on the wall (`launcher_push`).
task LauncherCurse (e, c) {
    val token = []
    set e.launcher_curse = token
    await(c.duration * 1s)
    if e.launcher_curse == token {
        set e.launcher_push = c.a1
        push(e, rfloat(50, 75)*(c.a2.knockback_m || 1), rtable([0, math.pi, math.pi/2, -math.pi/2]))
    }
}

;; The damage over time of the leader (`main.current.player.dot_dmg_m`).
func leader_dot (A) {
    (A.units@0) && (A.units@0).dot_dmg_m || 1
}

;; A crit on an enemy (the critical strike).
task CritFx (e, fx) {
    shake(2.5, 0.25)
    play(rogue_crit1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    play(rogue_crit2, [pitch=rfloat(0.95, 1.05), volume=0.15])
    loop _ in 2 {
        spawn @fx HitParticle(e.x, e.y, [color=e.color, v=rfloat(100, 400)])
    }
    spawn @fx HitCircle(e.x, e.y, [rs=12, color=fg@0, duration=0.3, scale_down=true, change_color=[0.5, e.color]])
}

;; The strikes on a hit, before its damage: kinetic (a push), stunning
;; (a stun), silencing (a silence).
task Strikes (A, e, h, fx) {
    val ks = passive_level(A, "kinetic_strike")
    if ks && rbool(lv(ks, 10, 20, 30)) {
        var cx, cy = 0, 0
        loop _, u in A.units {
            set cx += u.x
            set cy += u.y
        }
        val n = math.max(#A.units, 1)
        push(e, rfloat(30, 60), if h.projectile => h.projectile.r => math.atan2(e.y - cy/n, e.x - cx/n))
    }
    val ss = passive_level(A, "stunning_strike")
    if ss && rbool(lv(ss, 8, 16, 24)) {
        stun(e, 2)
    }
    val sl = passive_level(A, "silencing_strike")
    if sl && rbool(lv(sl, 8, 16, 24)) {
        await Cursed(e, "silenced", true, 4)
    }
}

;; A pushed enemy against a wall (`Seeker:on_collision_enter`).
task PushedOnWall (A, e, fx, shots) {
    if passive_level(A, "heavy_impact") {
        hit(e, e.push_force, [from_enemy=true])
    }
    if passive_level(A, "tremor") {
        shake(2, 0.5)
        play(earth1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        val l = A.units@0
        spawn @fx Area(A, [x=e.x, y=e.y, r=e.r, w=0.75*e.push_force*(l && l.area_size_m || 1), color=yellow@0,
                           dmg=e.push_force/2, parent=l || e], fx)
    }
    if passive_level(A, "fracture") {
        play(earth2, [pitch=rfloat(0.95, 1.05), volume=0.5])
        loop i in 6 {
            spawn @shots Projectile(A, [x=e.x, y=e.y, color=red@0, r=i*math.pi/3, v=200, dmg=30,
                parent=A.units@0 || e, pierce=1], fx)
        }
    }
}

;; The passives on the death of an enemy: a ceremonial dagger, a homing
;; barrage, infesting critters, gold (lucky strike), a healing orb.
task DeathPassives (A, e, fx, shots) {
    val l = A.units@0
    if passive_level(A, "ceremonial_dagger") && l {
        play(rtable([scout1, scout2]), [pitch=rfloat(0.95, 1.05), volume=0.35])
        spawn @fx HitCircle(e.x, e.y, [rs=6])
        val r = rfloat(0, 2*math.pi)
        spawn @shots Projectile(A, [x=e.x + 8*math.cos(r), y=e.y + 8*math.sin(r), v=250, r=r, color=red@0,
            dmg=e.max_hp, homing=true, character="jester", parent=l], fx)
    }
    val hb = passive_level(A, "homing_barrage")
    if hb && l && rbool(lv(hb, 8, 16, 24)) {
        val t = closest_enemy(A, l.x, l.y, 128)
        spawn @shots Barrage(A, l, if t => angle_to(l, t.x, t.y) => l.r, 4, [homing=true], fx, shots)
    }
    val is = passive_level(A, "infesting_strike")
    if is && l && rbool(lv(is, 10, 20, 30)) {
        play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        loop _ in 2 {
            spawn @shots Critter(A, e.x, e.y, rfloat(0, 2*math.pi), 5, l.dmg, l, fx)
        }
    }
    if passive_level(A, "lucky_strike") && rbool(8) {
        spawn @shots Gold(A, e.x, e.y, fx, shots)
    }
    if passive_level(A, "healing_strike") && rbool(8) {
        spawn @shots HealingOrb(A, e.x, e.y, fx)
    }
}
