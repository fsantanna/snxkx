    mercenary = [@1="[yellow]2[light_bg]/[light_bg]4 [fg]- [yellow]+8%[light_bg]/[light_bg]+16% [fg]chance for enemies to drop gold on death", @2="[light_bg]2[light_bg]/[yellow]4 [fg]- [light_bg]+8%[light_bg]/[yellow]+16% [fg]chance for enemies to drop gold on death", @3="[light_bg]2[light_bg]/[light_bg]4 [fg]- [light_bg]+8%[light_bg]/[light_bg]+16% [fg]chance for enemies to drop gold on death"],
