    healer = [@1="[yellow]2[light_bg]/[light_bg]4 [fg]- [yellow]+15%[light_bg]/[light_bg]+30% [fg] chance to create [yellow]+1[fg] healing orb on healing orb creation", @2="[light_bg]2[light_bg]/[yellow]4 [fg]- [light_bg]+15%[light_bg]/[yellow]+30% [fg] chance to create [yellow]+1[fg] healing orb on healing orb creation", @3="[light_bg]2[light_bg]/[light_bg]4 [fg]- [light_bg]+15%[light_bg]/[light_bg]+30% [fg] chance to create [yellow]+1[fg] healing orb on healing orb creation"],
