;; The arena, as `Arena` of the original (`arena.lua`): walls around 80%
;; of the screen, the snake, and its enemies, in a physics world.
;;
;; The arena is a record shared by its entities (`main.current` of the
;; original): the world, the units of the snake in order, the enemies,
;; and counters. Its layers are pools, drawn in order: the floor, the
;; bodies, the covers of the walls, and the effects, through the camera.

func new_arena (level, menu) {
    [
        level = level || 1, ng = 0, menu = menu,
        units = [], enemies = [], path = [],
        x1 = W/2 - 0.8*W/2, y1 = H/2 - 0.8*H/2,
        x2 = W/2 + 0.8*W/2, y2 = H/2 + 0.8*H/2,
        damage_dealt = 0, damage_taken = 0,
    ]
}

;; The physics world of the arena, with the tags and filters of the
;; original (`Arena:on_enter`).
func arena_world () {
    val w = phys_world(32, [:player, :enemy, :projectile, :enemy_projectile, :force_field, :ghost])
    phys_disable(w, :player, :player)
    phys_disable(w, :player, :projectile)
    phys_disable(w, :player, :enemy_projectile)
    phys_disable(w, :projectile, :projectile)
    phys_disable(w, :projectile, :enemy_projectile)
    phys_disable(w, :projectile, :enemy)
    phys_disable(w, :enemy_projectile, :enemy)
    phys_disable(w, :enemy_projectile, :enemy_projectile)
    phys_disable(w, :player, :force_field)
    phys_disable(w, :projectile, :force_field)
    phys_disable(w, :ghost, :player)
    phys_disable(w, :ghost, :projectile)
    phys_disable(w, :ghost, :enemy)
    phys_disable(w, :ghost, :enemy_projectile)
    phys_disable(w, :ghost, :ghost)
    phys_disable(w, :ghost, :force_field)
    phys_trigger(w, :projectile, :enemy)
    phys_trigger(w, :enemy_projectile, :player)
    phys_trigger(w, :player, :enemy_projectile)
    phys_trigger(w, :enemy_projectile, :enemy)
    phys_trigger(w, :player, :ghost)
    phys_trigger(w, :ghost, :player)
    w
}

;; A wall: a static rectangle, drawn as `Wall` and `WallCover`.
task Wall (A, x1, y1, x2, y2) {
    val rec = [ kind=:wall ]
    val cx = (x1 + x2)/2
    val cy = (y1 + y2)/2
    val hw = (x2 - x1)/2
    val hh = (y2 - y1)/2
    body(A.w, rec, :static, cx, cy, :solid, [:polygon, [-hw,-hh, hw,-hh, hw,hh, -hw,hh]])
    defer {
        body_free(A.w, rec.b)
    }
    val vs = rect_vertices(x1, y1, x2, y2)
    loop on :draw {
        eng.polygon(vs, bg@(-1))
    }
}

;; The walls around the arena: the four rectangles of the original.
func arena_walls (A) {
    [
        [-40, -40, A.x1, H + 40],
        [A.x2, -40, W + 40, H + 40],
        [A.x1, -40, A.x2, A.y1],
        [A.x1, A.y2, A.x2, H + 40],
    ]
}

;; The texts of the first level, on the floor: the keys, which shrink
;; away after 8s.
task FloorText (x, y, lines, sx) {
    val t = text(lines)
    val st = [ sy=sx ]
    spawn {
        loop on :draw {
            text_draw(t, x, y, 0, sx, st.sy)
        }
    }
    await 8s
    await Tween(0.2, st, [sy=0], linear)
    await(false)
}

;; An arena: a level of the run `A.run`, with the snake of its units, its
;; waves, and its end. With `enemies` ([x, y, level] each), the arena
;; has those instead of waves (for the tests). It ends when the next
;; screen covers it.
task Arena (A, enemies) {
    val w = arena_world()
    set A.w = w
    defer {
        phys_world_free()
    }
    set A.cond1 = hfx(1)
    set A.cond2 = hfx(1)
    set A.spawns_prevented = 0
    set A.gold_picked_up = 0
    set A.loop = A.run && A.run.loop || 0
    spawn Springs(A.cond1.s, A.cond2.s)

    ;; the layers, through the camera
    spawn {
        loop on :draw {
            cam_push()
        }
    }
    pin floor   = tasks()
    pin main    = tasks()
    pin foes    = tasks()
    pin shots   = tasks()
    pin effects = tasks()
    spawn Hud(A)
    spawn {
        loop on :draw {
            eng.pop()
            eng.canvas_draw_outside(STARS, A.x1, A.y1, A.x2, A.y2, white@0)
        }
    }
    pin ui = tasks()
    pin spawns = tasks()

    loop _, r in arena_walls(A) {
        spawn @main Wall(A, r@0, r@1, r@2, r@3)
    }
    spawn Stars()

    ;; the levels of the classes, as `Arena:on_enter` counts them
    set A.cl = class_levels(A.run.units)
    loop i, c in A.run.units {
        val u = [ character=unit_character(c), level=unit_level(c), index=i, chp=hfx(1) ]
        if i == 0 {
            set u.x = A.start && A.start.x || (W/2)
            set u.y = A.start && A.start.y || (H/2 + 16)
            set u.r = A.start && A.start.r || 0
        }
        set A.units@+ = u
        spawn @main Unit(A, u, effects, shots)
        if !A.menu {
            spawn @effects CharacterHP(A, u, A.x1 + 8 + i*22, A.y2 + 14)
        }
    }

    if (A.level == 1) && !A.menu {
        spawn @floor FloorText(W/2, H/2 + 2, [ [text="[light_bg]<- or a         -> or d", font=fat_font, alignment=:center] ], 0.6)
        spawn @floor FloorText(W/2, H/2 + 18, [ [text="[light_bg]turn left                                      turn right", font=pixul_font, alignment=:center] ], 1)
        spawn @floor FloorText(W/2, H/2 + 46, [ [text="[light_bg]esc - options", font=fat_font, alignment=:center] ], 0.6)
    }

    ;; the world steps after all entities have moved
    spawn {
        loop us on :clock {
            phys_step(w, us / 1000000)
        }
    }

    ;; for the benchmark (see `STRESS`), more seekers, in a grid
    loop i in (if A.menu => 0 => (STRESS || 0)) {
        spawn @foes Seeker(A, [x=60 + (i%20)*18, y=40 + (i//20)*19, level=A.level], effects, shots)
    }

    val r = par :any {
        await :Arena.died
        :died
    } with {
        ifs {
            A.menu => await(false)
            enemies => {
                loop _, e in enemies {
                    spawn @foes Seeker(A, [x=e@0, y=e@1, level=e@2, elite=e@3, boss=e@4], effects, shots)
                }
                await Quiet(foes, spawns)
            }
            (((A.level - 25*A.loop) % 6) == 0) || ((A.level % 25) == 0) => par :any {
                await BossWaves(A, foes, spawns, effects, shots)
            } with {
                await Respawns(A, foes, spawns, effects, shots)
            }
            else => par :any {
                await Waves(A, foes, spawns, effects, shots)
            } with {
                await Respawns(A, foes, spawns, effects, shots)
            }
        }
        :clear
    }
    if r == :died {
        await Died(A, ui)
    } else {
        await Clear(A, ui)
    }
}
