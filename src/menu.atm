;; The main menu, as `MainMenu` of the original (`mainmenu.lua`): an
;; arena with a snake that runs by itself, dimmed, under the title and
;; the buttons.
;;
;; It returns :quit, or emits `:goto [screen, ...]` when the run starts
;; and lives on until the transition covers it.

;; The arena of the menu, 80% of the screen.
val MENU_X1 = W/2 - 0.8*W/2
val MENU_Y1 = H/2 - 0.8*H/2
val MENU_X2 = W/2 + 0.8*W/2
val MENU_Y2 = H/2 + 0.8*H/2

func rect_vertices (x1, y1, x2, y2) {
    [x1,y1, x2,y1, x2,y2, x1,y2]
}

val modal_transparent = rgba(0.1, 0.1, 0.1, 0.6)

task Menu () {
    val title = text([ [text="[wavy_mid, fg]SNKRX", font=fat_font, alignment=:center] ])

    ;; the arena, with a snake that runs by itself, as the original's
    val A = new_arena(1, true)
    set A.start = [
        x = W/2 + rfloat(-48, 48),
        y = H/2 + 16 + rfloat(-48, 48),
        r = rtable([-math.pi/4, math.pi/4, 3*math.pi/4, -3*math.pi/4]),
    ]
    set A.run = [ units=[["psykino", 1], ["magician", 1], ["bane", 1], ["scout", 1],
                         ["cannoneer", 1], ["swordsman", 1], ["archer", 1]] ]
    spawn Arena(A)

    ;; everything dimmed under the interface
    spawn {
        loop on :draw {
            eng.rect(W/2, H/2, 2*W, 2*H, nil, nil, modal_transparent)
        }
    }

    pin bs = tasks()
    spawn @bs Button(task, :arena_run, 55, H/2 - 10, "arena run")
    spawn @bs Button(task, :options,   47, H/2 + 12, "options")
    spawn @bs Button(task, :quit,      37, H/2 + 34, "quit")
    val soundtrack =
        spawn @bs Button(task, :soundtrack, W - 72, H - 40, "buy the soundtrack!")
    spawn @bs Button(task, :discord, W - 92, H - 17, "join the community discord!")

    spawn {
        loop on :draw {
            text_draw(title, 60, H/2 - 40)
        }
    }

    ;; the soundtrack button nudges itself every 2s
    spawn {
        loop {
            await 2s
            spring_pull(soundtrack.pub.spring, 0.025, 200, 10)
        }
    }

    loop {
        val e = await <:Button.click || :key.dn>
        val id = if e ?? :key.dn => (if e.name == "Escape" => :options => nil) => e.id
        match id {
            :arena_run => {
                play(ui_transition2, [pitch=rfloat(0.95, 1.05), volume=0.5])
                play(ui_switch2, [pitch=rfloat(0.95, 1.05), volume=0.5])
                play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                emit @:global :goto [ screen=:buy_screen, x=W/2, y=H/2, color=fg@0,
                                      text="[wavy, bg]starting..." ]
                await(false)
            }
            :quit => {
                return :quit
            }
            \{ (it == :soundtrack) || (it == :discord) } => {
                ;; the original opens a page in the browser
                play(ui_switch2, [pitch=rfloat(0.95, 1.05), volume=0.5])
                spring_pull(e.spring, 0.2, 200, 10)
                play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
            }
            :options => {
                play(ui_switch1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                await Options(:menu)
            }
            else => nil
        }
    }
}
