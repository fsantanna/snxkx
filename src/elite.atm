;; The elite seekers and the first boss, as the branches of `Seeker:init`
;; of the original (`enemies.lua:5-260`): the speed booster, the
;; exploder, the shooter, the headbutter, and the boss "speed_booster";
;; with `EnemyProjectile`, `ExploderMine`, and `LightningLine`.
;;
;; An elite runs its attack beside its movement, as the original runs
;; its timers beside its update. The two share one thing: whether the
;; seeker aims (`e.aiming`, a count of the attacks that aim) instead of
;; chasing.

;; As `LightningLine`: a jagged line from one point to another, which
;; thins out in 0.1s.
task LightningLine (src, dst, color, fx) {
    var lines = [ [src.x, src.y, dst.x, dst.y] ]
    var off = 8
    loop _ in 3 {
        val next = []
        loop _, l in lines {
            val x1, y1, x2, y2 = l@0, l@1, l@2, l@3
            val px, py = vnormalize(x2 - x1, y2 - y1)
            val k = rfloat(-off, off)
            val mx = (x1 + x2)/2 + (-py)*k
            val my = (y1 + y2)/2 + px*k
            set next@+ = [x1, y1, mx, my]
            set next@+ = [mx, my, x2, y2]
        }
        set lines = next
        set off = off/2
    }
    val pts = []
    loop _, l in lines {
        set pts@+ = l@0
        set pts@+ = l@1
    }
    val st = [ w=3 ]
    spawn @fx HitCircle(src.x, src.y, [rs=6, color=fg@0, duration=0.1])
    loop _ in 2 {
        spawn @fx HitParticle(src.x, src.y, [color=color])
    }
    spawn @fx HitCircle(dst.x, dst.y, [rs=6, color=fg@0, duration=0.1])
    spawn @fx HitParticle(dst.x, dst.y, [color=color])
    spawn {
        loop on :draw {
            eng.polyline(pts, color, st.w)
        }
    }
    await Tween(0.1, st, [w=1], linear)
}

;; As `EnemyProjectile`: it flies along `r`, dies on a wall, and hits a
;; unit (or, from a shooter, an enemy) that it crosses.
task EnemyProjectile (A, p, fx) {
    set p.kind = :enemy_projectile
    set p.w = 10
    set p.h = 4
    body(A.w, p, :dynamic, p.x, p.y, :enemy_projectile, [:rect, 10, 4])
    defer {
        body_free(A.w, p.b)
    }
    spawn {
        loop on :draw {
            eng.push(p.x, p.y, p.r)
            eng.rect(p.x, p.y, 10, 4, 2, 2, p.color)
            eng.pop()
        }
    }
    val dx, dy = par :any {
        loop on :clock {
            set p.x, p.y = body_pos(p.b)
            body_set(p.b, :angle, p.r)
            body_set(p.b, :velocity, p.v*math.cos(p.r), p.v*math.sin(p.r))
        }
    } with {
        val e = await :collision.enter until (it.b == p.b) && (it.other.kind == :wall)
        return (e.x, e.y)
    } with {
        loop e on :trigger.enter until it.b == p.b {
            val o = e.other
            ifs {
                o.kind == :player => {
                    hit(o, p.dmg)
                    break (p.x, p.y)
                }
                (o.kind == :critter) && passive_level(A, "meat_shield") => {
                    hit(o, 1000)
                    break (p.x, p.y)
                }
                (o.kind == :enemy) && (p.source == :shooter) => {
                    hit(o, 0.5*p.dmg, [from_enemy=true])
                    break (p.x, p.y)
                }
            }
        }
    }
    loop _ in rint(2, 3) {
        spawn @fx HitParticle(dx, dy, [r=rfloat(0, 2*math.pi), color=p.color])
    }
    spawn @fx HitCircle(dx, dy, [scale_down=true])
    play(proj_hit_wall1, [pitch=rfloat(0.9, 1.1), volume=0.05])
}

;; As `ExploderMine`: a mine that ticks three times, 0.8s apart, and
;; bursts into projectiles.
task ExploderMine (A, x, y, src, fx, shots) {
    val s = spring(1)
    val h = hfx(1)
    spawn Springs(s, h.s)
    spawn {
        loop on :draw {
            eng.push(x, y, 0, s.x)
            eng.circle(x, y, 2.5, if h.f > 0 => fg@0 => blue@0)
            eng.pop()
        }
    }
    await Tween(0.05, [t=0], [t=1], linear)
    spring_pull(s, 0.15)
    pin fxs = tasks()
    loop i in 3 {
        await 800ms
        play(mine1, [pitch=1 + i*0.1, volume=0.5])
        spring_pull(s, 0.5, 200, 10)
        spawn @fxs HfxUse(h, 0.5, 200, 10, 0.2)
    }
    play(shoot1, [pitch=rfloat(0.95, 1.05), volume=0.4])
    play(cannoneer1, [pitch=rfloat(0.95, 1.05), volume=0.4])
    loop _ in 4 {
        spawn @fx HitParticle(x, y, [r=rfloat(0, 2*math.pi), color=blue@0])
    }
    spawn @fx HitCircle(x, y, [])
    val n = 8
    loop i in n {
        spawn @shots EnemyProjectile(A, [x=x, y=y, color=blue@0, r=i*math.pi/(n/2),
            v=120 + math.min(5*src.level, 300), dmg=1.3*src.dmg], fx)
    }
}

;; As `Seeker:speed_boost(duration)`: the seeker runs faster, by a factor
;; that falls from 3 to half of it along the boost. A new boost restarts.
task SpeedBoosts (e) {
    var b = await :SpeedBoost until it.to == e
    loop {
        set b = par :any {
            await :SpeedBoost until it.to == e
        } with {
            val k = 3 + 0.015*e.level
            var t = 0
            loop us on :clock {
                set t += us / 1000000
                set e.boost = k*remap(t, 0, k, 1, 0.5)
                until t > b.duration
            }
            set e.boost = 1
            await :SpeedBoost until it.to == e
        }
    }
}

;; Boosts the seekers within 128 of `e` (up to `max`), with lines.
task BoostAround (A, e, max, duration, fx) {
    val es = []
    loop _, o in enemies_in_circle(A, e.x, e.y, 128) {
        if (o != e) && (#es < (max || 1000)) {
            set es@+ = o
        }
    }
    if #es > 0 {
        play(buff1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        spawn @fx HitCircle(e.x, e.y, [rs=6, color=green@0, duration=0.1])
        loop _, o in es {
            spawn @fx LightningLine(e, o, green@0, fx)
            emit @:global :SpeedBoost [ to=o, duration=duration ]
        }
    }
}

;; The attack of an elite, beside its movement, while it lives.
task EliteAttack (A, e, fx, shots) {
    pin fxs = tasks()
    match e.elite {
        "speed_booster" => {
            await((rfloat(16, 24)) * 1s)
            hit(e, 10000)
            await(false)
        }
        "exploder" => {
            await((rfloat(16, 24)) * 1s)
            hit(e, 10000)
            await(false)
        }
        "shooter" => {
            await((rfloat(2, 4)) * 1s)
            set e.aiming += 1
            loop {
                ;; as `set_every_multiplier('shooter', ...)` of the update
                await((rfloat(4, 6)*(1 - math.min(e.level*0.02, 0.25))) * 1s)
                ;; not while silenced or stunned
                loop i in (if e.silenced || e.stunned => 0 => 3) {
                    if i > 0 {
                        await((math.max(1 - e.level*0.01, 0.25)*0.15) * 1s)
                    }
                    play(shoot1, [pitch=rfloat(0.95, 1.05), volume=0.1])
                    spawn @fxs HfxUse(e.hit, 0.25, 200, 10, 0.1)
                    val r = e.r
                    spawn @fx HitCircle(e.x + 0.8*14*math.cos(r), e.y + 0.8*14*math.sin(r), [rs=6])
                    spawn @shots EnemyProjectile(A, [x=e.x + 1.6*14*math.cos(r), y=e.y + 1.6*14*math.sin(r),
                        color=fg@0, r=r, v=math.min(140 + 3.5*e.level, 300), dmg=e.dmg, source=:shooter], fx)
                }
            }
        }
        "headbutter" => {
            val o_r, o_g, o_b = comps(orange@0)
            val f_r, f_g, f_b = comps(fg@0)
            val c = [ r=o_r, g=o_g, b=o_b ]
            spawn {
                loop on :clock {
                    set e.color = rgba(c.r, c.g, c.b)
                }
            }
            loop {
                ;; near the leader, and 10s after the last headbutt (not while
                ;; silenced or stunned)
                loop on :clock {
                    val l = A.units@0
                    until l && (math.sqrt((e.x - l.x)*(e.x - l.x) + (e.y - l.y)*(e.y - l.y)) < 76) &&
                          !e.silenced && !e.stunned
                }
                ;; charges for 2s, turning white
                set e.aiming += 1
                await Tween(2, c, [r=f_r, g=f_g, b=f_b], cubic_in_out)
                set e.aiming -= 1
                ;; and headbutts the leader
                spawn @fxs Tween(0.25, c, [r=o_r, g=o_g, b=o_b], linear)
                play(headbutt1, [pitch=rfloat(0.95, 1.05), volume=0.2])
                set e.headbutting = true
                body_set(e.b, :damping, 0)
                val l = A.units@0
                val a = if l => math.atan2(l.y - e.y, l.x - e.x) => e.r
                ;; the next one is 10s (of real time, as `love.timer.getTime`)
                ;; after the start of this one
                par :all {
                    await WaitReal(10)
                } with {
                    spawn @fxs SteeringImpulse(e.st, 300, a, 0.75)
                    ;; the dash pushes the enemies it meets, and ends on one, on
                    ;; a unit (see `Unit`), or after 0.75s
                    par :any {
                        await 750ms
                    } with {
                        loop on :clock {
                            until !e.headbutting
                        }
                    } with {
                        val c = await :collision.enter until (it.b == e.b) && (it.other.kind == :enemy)
                        val vx, vy = body_vel(e.b)
                        push(c.other, math.sqrt(vx*vx + vy*vy)/4, angle_to(c.other, e.x, e.y))
                        spawn @fx HitCircle(c.x, c.y, [rs=6, color=fg@0, duration=0.1])
                        loop _ in 2 {
                            spawn @fx HitParticle(c.x, c.y, [color=e.color])
                        }
                        play(hit2, [pitch=rfloat(0.95, 1.05), volume=0.35])
                    }
                    set e.headbutting = false
                }
            }
        }
        "tank" => loop {
            ;; it pushes the closest enemy toward the leader
            await((rfloat(3, 5)*remap(A.ng || 0, 0, 5, 1, 0.75)) * 1s)
            if !(e.silenced || e.stunned) {
                val o = closest_enemy(A, e.x, e.y, 64, [e])
                val l = A.units@0
                if o && l {
                    play(wizard1, [pitch=rfloat(0.95, 1.05), volume=0.5])
                    spawn @fx HitCircle(e.x, e.y, [rs=6, color=yellow@0, duration=0.1])
                    spawn @fx LightningLine(e, o, yellow@0, fx)
                    push(o, rfloat(30, 50), angle_to(o, l.x, l.y), true)
                }
            }
        }
        else => await(false)
    }
}

;; As `apply_steering_impulse(f, r, s)`: an impulse added to the velocity
;; for `s` seconds, which fades in its second half.
task SteeringImpulse (st, f, r, s) {
    set st.ix = f*math.cos(r)
    set st.iy = f*math.sin(r)
    defer {
        set st.ix = 0
        set st.iy = 0
    }
    await((s/2) * 1s)
    await Tween(s/2, st, [ix=0, iy=0], linear)
}

;; The attack of a boss, every few seconds (`'boss_attack'`), shown by its
;; bar (`e.attack_ratio`): the speed booster boosts up to four seekers
;; around it (8s), the forcer pulls the enemies together and throws them
;; at the snake (6s), the swarmer and the exploder sacrifice a seeker for
;; critters or a mine (4s), and the randomizer does one of these at random
;; (6s), changing its color all the time (`enemies.lua:19-160`).
task BossAttack (A, e, fx, shots) {
    pin fxs = tasks()
    val d = match e.boss { "speed_booster" => 8 ; "forcer" => 6 ; "randomizer" => 6 ; else => 4 }
    if e.boss == "randomizer" {
        spawn @fxs Randomize(e)
    }
    loop {
        var t = 0
        loop us on :clock {
            set t += us / 1000000
            set e.attack_ratio = t/d
            until t > d
        }
        if !(e.silenced || e.stunned) {
            val k = if e.boss == "randomizer" => rtable(["explode", "swarm", "force", "speed_boost"]) => e.boss
            val near = enemies_in_circle(A, e.x, e.y, 128)
            match k {
                "speed_booster" => spawn @fxs BoostAround(A, e, 4, 3 + e.level*0.015 + (A.ng || 0)*0.1, fx)
                "speed_boost" => spawn @fxs BoostAround(A, e, nil, 3 + e.level*0.015 + (A.ng || 0)*0.1, fx)
                "forcer" => spawn @fxs ForcerPull(A, e, fx)
                "force" => spawn @fxs ForceAround(A, e, fx)
                "swarmer" => spawn @fxs Sacrifice(A, e, others(A, e), :swarm, fx, shots)
                "swarm" => spawn @fxs Sacrifice(A, e, near, :swarm, fx, shots)
                "exploder" => spawn @fxs Sacrifice(A, e, others(A, e), :mine, fx, shots)
                "explode" => spawn @fxs Sacrifice(A, e, near, :burst, fx, shots)
            }
        }
    }
}

;; The seekers other than `e`.
func others (A, e) {
    val out = []
    loop _, o in A.enemies {
        if (o != e) && (o.kind == :enemy) {
            set out@+ = o
        }
    }
    out
}

;; A boss kills a random seeker of `es`, which turns into critters (4 to
;; 6), a mine, or a burst of projectiles.
task Sacrifice (A, e, es, what, fx, shots) {
    val ss = []
    loop _, o in es {
        if (o != e) && (o.kind == :enemy) {
            set ss@+ = o
        }
    }
    if #ss == 0 {
        return nil
    }
    val o = rtable(ss)
    val color = match what { :swarm => purple@0 ; else => blue@0 }
    spawn @fx HitCircle(e.x, e.y, [rs=6, color=color, duration=0.1])
    spawn @fx LightningLine(e, o, color, fx)
    hit(o, 10000)
    match what {
        :swarm => {
            play(critter1, [pitch=rfloat(0.95, 1.05), volume=0.5])
            play(critter3, [pitch=rfloat(0.95, 1.05), volume=0.6])
            loop _ in rint(4, 6) {
                spawn @shots EnemyCritter(A, o.x, o.y, rfloat(0, 2*math.pi), 8 + 0.1*o.level, 2*o.dmg, nil, fx)
            }
        }
        :mine => {
            play(mine1, [pitch=rfloat(0.95, 1.05), volume=0.5])
            spawn @shots ExploderMine(A, o.x, o.y, o, fx, shots)
        }
        :burst => {
            play(shoot1, [pitch=rfloat(0.95, 1.05), volume=0.4])
            val n = 8 + (A.ng || 0)*2
            loop i in n {
                spawn @shots EnemyProjectile(A, [x=o.x, y=o.y, color=blue@0, r=i*math.pi/(n/2),
                    v=125 + 5*o.level, dmg=(1 + 0.15*(A.ng || 0))*o.dmg], fx)
            }
        }
    }
}

;; The force of the randomizer: the seekers within 64 thrown at the leader.
task ForceAround (A, e, fx) {
    val es = enemies_in_circle(A, e.x, e.y, 64)
    if #es > 0 {
        play(wizard1, [pitch=rfloat(0.95, 1.05), volume=0.5])
        spawn @fx HitCircle(e.x, e.y, [rs=6, color=yellow@0, duration=0.1])
        val l = A.units@0
        loop _, o in es {
            spawn @fx LightningLine(e, o, yellow@0, fx)
            if l {
                push(o, rfloat(40, 80), angle_to(o, l.x, l.y), true)
            }
        }
    }
}

;; The randomizer changes its color every 0.07s.
task Randomize (e) {
    loop {
        set e.color = rtable([green@0, purple@0, yellow@0, blue@0])
        await 70ms
    }
}

;; The pull of the forcer: a circle at the middle of the enemies pulls
;; them for 2s, and then they are thrown at the leader.
task ForcerPull (A, e, fx) {
    var x, y = 0, 0
    if #A.enemies > 0 {
        loop _, o in A.enemies {
            set x += o.x
            set y += o.y
        }
        set x = x/#A.enemies
        set y = y/#A.enemies
    } else {
        val l = A.units@0
        set x = l && l.x || (W/2)
        set y = l && l.y || (H/2)
    }
    val px = x + rfloat(-16, 16)
    val py = y + rfloat(-16, 16)
    val st = [ prs=0, vr=0 ]
    val dvr = rfloat(-math.pi/4, math.pi/4)
    val faint = alpha(yellow@0, 0.08)
    var shown = true
    pin ps = tasks()
    spawn @ps Tween(0.05, st, [prs=4], cubic_in_out)
    spawn {
        loop on :draw {
            if shown {
                eng.circle(px, py, st.prs + rfloat(-1, 1), yellow@0)
                round_area(px, py, 160, st.vr, 1, yellow@0, faint)
            }
        }
    }
    spawn {
        loop _ in math.floor(2/0.08) {
            await 80ms
            spawn @fx HitParticle(px, py, [color=yellow@0])
        }
    }
    spawn {
        await((2 - 0.05*7) * 1s)
        loop i in 7 {
            if i > 0 {
                await 50ms
            }
            set shown = !shown
        }
    }
    play(force1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    par :any {
        await 2s
    } with {
        loop us on :clock {
            loop _, o in enemies_in_circle(A, px, py, 160) {
                val dd = math.sqrt((o.x - px)*(o.x - px) + (o.y - py)*(o.y - py))
                if o.st {
                    steer_force(o.st, remap(dd, 0, 160, 400, 200), angle_to(o, px, py))
                }
            }
            set st.vr += dvr*(us / 1000000)
        }
    }
    play(wizard1, [pitch=rfloat(0.95, 1.05), volume=0.5])
    spawn @fx HitCircle(e.x, e.y, [rs=6, color=yellow@0, duration=0.1])
    val l = A.units@0
    loop _, o in enemies_in_circle(A, px, py, 160) {
        spawn @fx LightningLine(e, o, yellow@0, fx)
        if l {
            push(o, rfloat(40, 80), angle_to(o, l.x, l.y), true)
        }
    }
}

;; As `EnemyCritter`: a small purple enemy, thrown out, that chases the
;; leader and bites a unit once (and dies). The projectile that killed its
;; seeker does not hit it in its first 0.5s.
task EnemyCritter (A, x, y, r, v, dmg, from, fx) {
    trace("add", string.format("EnemyCritter %.1f %.1f", x, y))
    val c = [ kind=:enemy_critter, w=7, h=4, x=x, y=y, r=r, stats=:critter, classes=[:enemy_critter],
              color=purple@0, hit=hfx(1), hp_shown=0 ]
    unit_stats(c, true, A.ng)
    set c.dmg = dmg
    body(A.w, c, :dynamic, x, y, :enemy_projectile, [:rect, 7, 4])
    body_restitution(c.b, 0.5)
    val st = steerable(c.b, c.v, 400, math.pi, 1)
    set c.st = st
    set A.enemies@+ = c
    defer {
        body_free(A.w, c.b)
        val es = []
        loop _, o in A.enemies {
            if o != c {
                set es@+ = o
            }
        }
        set A.enemies = es
    }
    spawn Springs(c.hit.s)
    pin fxs = tasks()
    spawn SeekerSlows(c)
    spawn {
        loop on :draw {
            eng.push(c.x, c.y, c.r, c.hit.s.x)
            eng.rect(c.x, c.y, 7, 4, 2, 2, if c.hit.f > 0 => fg@0 => c.color)
            eng.pop()
            draw_hp_bar(c, 7, 4, red@0)
        }
    }
    spawn {
        loop w on :collision.enter until (it.b == c.b) && (it.other.kind == :wall) {
            spawn @fxs HfxUse(c.hit, 0.15, 200, 10, 0.1)
            bounce(c, w.nx, w.ny)
        }
    }
    var shielded = from
    spawn {
        await 500ms
        set shielded = nil
    }
    par :any {
        loop h on :Hit until it.to == c {
            if !(shielded && (h.projectile == shielded)) {
                spawn @fxs HfxUse(c.hit, 0.25, 200, 10)
                spawn @fxs ShowHp(c)
                set c.hp -= math.max(h.dmg, 0)
            }
            until c.hp <= 0
        }
    } with {
        val t = await :trigger.enter until (it.b == c.b) && (it.other.kind == :player)
        hit(t.other, c.dmg, [from_enemy=true])
    } with {
        var p = [ f=v, r=r ]
        loop {
            loop {
                body_set(c.b, :impulse, p.f*math.cos(p.r), p.f*math.sin(p.r))
                body_set(c.b, :angular_impulse,
                    rtable([rfloat(-12*math.pi, -4*math.pi), rfloat(4*math.pi, 12*math.pi)]))
                body_set(c.b, :damping, 1.5)
                body_set(c.b, :angular_damping, 1.5)
                set p = par :any {
                    loop on :clock {
                        set c.x, c.y = body_pos(c.b)
                        set c.r = body_angle(c.b)
                        val vx, vy = body_vel(c.b)
                        until math.sqrt(vx*vx + vy*vy) < 50
                    }
                    nil
                } with {
                    await :Push until it.to == c
                }
                until !p
            }
            body_set(c.b, :damping, 0)
            body_set(c.b, :angular_damping, 0)
            set p = par :any {
                loop on :clock {
                    set c.x, c.y = body_pos(c.b)
                    set c.r = body_angle(c.b)
                    set c.buff_mvspd_m = (c.slowed || 1)*(c.temporal_chains_mvspd_m || 1)
                    unit_stats(c, false, A.ng)
                    set st.max_v = c.max_v
                    steer_update(st)
                    val l = A.units@0
                    if l {
                        seek_point(st, l.x, l.y)
                    }
                    wander(st, 50, 200, 50)
                    separate(st, 8, A.enemies)
                    rotate_towards_velocity(c.b, 1)
                }
            } with {
                await :Push until it.to == c
            }
        }
    }
    loop _ in rint(2, 3) {
        spawn @fx HitParticle(c.x, c.y, [r=rfloat(0, 2*math.pi), color=c.color])
    }
    spawn @fx HitCircle(c.x, c.y, [scale_down=true])
    play(rtable([enemy_die1, enemy_die2]), [pitch=rfloat(0.9, 1.1), volume=0.5])
    play(critter2, [pitch=rfloat(0.95, 1.05), volume=0.2])
}
