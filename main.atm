;; SNKRX in Atmos: the screens, one after the other, under the
;; transitions between them.

include "src/game.atm"

;; A new run, as the button "arena run" of the original makes one.
func new_run () {
    [ level=1, loop=0, gold=3, units=[], passives=[], pool=passive_pool(), shop_level=1, shop_xp=0 ]
}

;; The arena of the level of the run.
task Play (run) {
    val A = new_arena(run.level)
    set A.run = run
    await Arena(A)
}

;; The music, as `main_song_instance` of the original: a random song of
;; the five, louder in the menu and the arena (0.5, in 2s) than in the
;; shop (0.2, in 1s), and another one when it ends. A restart stops it.
task Music () {
    val st = [ v=0.5 ]
    spawn {
        var e = await :Music
        loop {
            set e = par :any {
                await TweenReal(e.d, st, [v=e.v], linear)
                await(false)
            } with {
                await :Music
            }
        }
    }
    loop {
        val song = rtable([song1, song2, song3, song4, song5])
        val inst = play(song, [volume=st.v])
        if inst < 0 {
            await(false)        ;; no sound (SNX_MUTE): one song, as at the start
        }
        par :any {
            loop on :tick {
                set_volume(inst, st.v*VOLUME.music)
                until !playing(inst)
            }
        } with {
            await :Music.stop
            stop(inst)
        }
    }
}

spawn Background()
spawn Music()
spawn Camera()
spawn Input()
spawn SlowMotion()

par {
    ;; the screens: each one runs until it asks for the next one, and the
    ;; transition covers it
    state_load()
    var run = new_run()
    var screen = [ Menu, nil, "mainmenu" ]
    loop {
        val next = do {
            trace("go", screen@2)
            pin s = spawn (screen@0)(screen@1)
            val e = await <:goto || s>
            if (e == :quit) || ((e ?? :goto) && (e.screen == :quit)) {
                break
            }
            await :covered
            e
        }
        eng.slow(1)
        match next.screen {
            :buy_screen => emit @:global :Music [ v=0.2, d=1 ]
            :restart => {
                emit @:global :Music.stop
                emit @:global :Music [ v=0.2, d=1 ]
            }
            else => emit @:global :Music [ v=0.5, d=2 ]
        }
        set screen = match next.screen {
            :buy_screen => do {
                if next.counting {
                    ;; the shop gains experience after each even level
                    ;; (`Arena:transition`)
                    if ((run.level % 2) == 0) && (run.shop_level < 5) {
                        set run.shop_xp += 1
                        if run.shop_xp >= shop_max_xp(run.shop_level) {
                            set run.shop_xp = 0
                            set run.shop_level += 1
                        }
                    }
                    set run.level += 1
                } else {
                    ;; "arena run": the run saved, if any (`system.load_run`)
                    set run = run_load() || run
                }
                [ Shop, run, "buy_screen" ]
            }
            :arena => [ Play, run, "arena" ]
            :restart => do {
                run_clear()
                set run = new_run()
                [ Shop, run, "buy_screen" ]
            }
            else => [ Menu, nil, "mainmenu" ]
        }
    }
} with {
    ;; the transitions, over the screens
    loop e on :goto {
        if e.screen != :quit {
            await Transition(e)
        }
    }
}
